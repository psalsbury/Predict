@model IEnumerable<Predict.Models.Pool>

@{
    ViewBag.Title = "Manage Your Pools";
}

<p>
    @Html.ActionLink("Create New Pool", "New")
</p>
<table id="poolsTable" class="table table-bordered table-hover">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.PoolName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ModifiedDateTime)
        </th>
        <th>
            &nbsp;
        </th>
        <th>
            &nbsp;
        </th>
        <th>
            &nbsp;
        </th>

    </tr>
    </thead>

        @foreach (var item in Model)
        {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.PoolName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ModifiedDateTime)
        </td>
        <td>
            <button class="btn btn-info" value="Edit" onclick="window.location.href= '@String.Format("/Pools/Edit/{0}",@item.Id)'">Edit</button>
        </td>
    <td>
        <button class="btn btn-danger" value="Remove" poolId="@item.Id">Delete</button>
    </td>
        <td>
            <button class="btn btn-primary" value="Players" onclick="window.location.href= '@String.Format("/Pools/Players/{0}",@item.Id)'">Players</button>
        </td>
    </tr>
        }

</table>
<script src="/Scripts/bootbox.js"></script>
<script>
    $("#poolsTable").on("click", ".btn-danger", function () {
        var button = $(this);
        bootbox.confirm("Are you sure you want to delete this pool?", function (result) {
            if (result) {
                $.ajax(
                    {
                        url: "/api/pools/" + button.attr("poolId"),
                        method: "DELETE",
                        success: function () {
                            $(button.closest("tr")).fadeOut(1000);
                        }
                    });
            }
        });
    });
</script>


<script>

    $(function () {
        $("#poolsTable").DataTable({'columnDefs': [ {
            'targets': [2,3,4], /* column index */
            'orderable': false, /* true or false */

        }]});
    });

</script>