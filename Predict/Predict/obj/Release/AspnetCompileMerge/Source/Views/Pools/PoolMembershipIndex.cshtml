@using Microsoft.Ajax.Utilities
@using Microsoft.AspNet.Identity
@model Predict.ViewModels.PoolMembershipViewModel

@{
    ViewBag.Title = "Pool Membership";
}

<div class="nav-tabs-custom">
    <ul class="nav nav-tabs">
        <li class="active"><a href="#tab_1" data-toggle="tab"><b>Your Pools</b></a></li>
        <li><a href="#tab_2" data-toggle="tab"><b>All other pools</b></a></li>
    </ul>

    <div class="tab-content nav-tabs-custom">
        <div class="tab-pane active" id="tab_1">

            <table class="table table-bordered table-hover" id="poolMembershipJoined">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Pools[0].PoolName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Pools[0].InitialInfo)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Pools[0].EntryFee)
                        </th>
                        <th></th>
                    </tr>
                </thead>

                @foreach (var joinedPool in Model.JoinedPools)
                {
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => joinedPool.Pool.PoolName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => joinedPool.Pool.InitialInfo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => joinedPool.Pool.EntryFee)
                            </td>

                            <td>
                                @{
                                    if (!Model.ReadOnlyPools.Exists(p => p.Equals(joinedPool.PoolId)))
                                    {
                                        <button class="btn btn-delete js-approve" value="Join" dataPlayerId="@Model.PlayerId" dataPoolId="@joinedPool.Pool.Id" poolName="@joinedPool.Pool.PoolName">Leave</button>
                                    }
                                }
                            </td>

                        </tr>
                    }
                }
            </table>
        </div>

        <div class="tab-pane" id="tab_2">

            <table class="table table-bordered table-hover" id="poolMembershipNotJoined">
                <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Pools[0].PoolName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Pools[0].InitialInfo)
                    </th>
                    <th>
                        Join Code Required
                    </th>
                    <th>
                        
                    </th>
                </tr>
                </thead>
                @foreach (var item in Model.Pools)
                {
                    {
                        var alreadyJoined = Model.JoinedPools.Exists(p => p.PoolId == item.Id);
                        var joinCodeNeeded = item.JoinCode.IsNullOrWhiteSpace() ? "" : "joinCodeNeeded";
                        var joinCodeNeededDisplay = item.JoinCode.IsNullOrWhiteSpace() ? "No" : "Yes";
                        if (!alreadyJoined)

                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PoolName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.InitialInfo)
                                </td>
                                <td>
                                    @joinCodeNeededDisplay.ToString()
                                </td>

                                <td>
                                    <button class="btn btn-success" value="join" joinCode="@joinCodeNeeded.ToString()" dataPoolId="@item.Id" poolName="@item.PoolName">Request to join</button>
                                </td>

                            </tr>
                        }
                    }
                }


            </table>
        </div>
    </div>
</div>

<script src="/Scripts/bootbox.js"></script>

<script>

    $(function () {
        $("#poolMembershipJoined, #poolMembershipNotJoined").DataTable( {
            "bLengthChange": false
        } );;
    });


</script>

<script>


    $("#poolMembershipJoined").on("click", ".js-approve", function() {
        var button = $(this);
        bootbox.confirm("Are you sure you want to leave the " + button.attr("poolName") + " pool?",
            function(result) {
                $.ajax(
                    {
                        url: "/api/poolPlayers/" + button.attr("dataPoolId") + "/@(User.Identity.GetUserId())",
                        method: "DELETE",
                        success: function() {
                            $(button.closest("tr")).fadeOut(1000);
                        }
                    });


            });
    });



    $("#poolMembershipNotJoined").on("click", ".btn-success", function () {
        var button = $(this);

        //to do
        //make an api to return whether a poolid needs a join code (return the code, if so use prompt, if not use confirm
        //if a code is needed check the entered code matches
        var ok = false;
        if (button.attr("joinCode") === "" || typeof button.attr("joinCode") === 'undefined') {
            bootbox.confirm("Are you sure you want to join the "+ button.attr("poolName") + " pool?",
                function(result) {
                    if (result) {
                        JoinPool(button,"");
                    }
                });
        }

        else {

            bootbox.prompt("To join the " + button.attr("poolName") + " pool, please enter the join code",
                function(result) {
                    JoinPool(button, result);
                });

        };
    });

    function JoinPool(button, joinCode) {
        $.ajax(
            {
                url: "/api/poolPlayers/AddNewPoolPlayer/" + button.attr("dataPoolId") + "/@(User.Identity.GetUserId())" + "/" + joinCode ,
                method: "PUT",
                success: function ()
                {
                    $(button.closest("tr")).fadeOut(1000);
                },
                error: function (request, status, error)
                {
                    bootbox.alert("Join request has not been successful");
                }
            });
    };


</script>
