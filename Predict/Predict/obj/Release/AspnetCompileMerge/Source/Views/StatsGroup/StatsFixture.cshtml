@model Predict.ViewModels.StatsFixtureViewModel

@{
    ViewBag.Title = Model.Fixture.HomeTeam.TeamName + " vs " + Model.Fixture.AwayTeam.TeamName + " prediction summary";
    var nbrPredictions = Model.StatFixturePredictions.Sum(s => s.NumberOfPredictions);

    var nbrPredictionsHomeWin = Model.StatFixturePredictions.Where(s => s.HomePrediction > s.AwayPrediction)
        .Sum(s => s.NumberOfPredictions);

    var nbrPredictionsAwayWin = Model.StatFixturePredictions.Where(s => s.HomePrediction < s.AwayPrediction)
        .Sum(s => s.NumberOfPredictions);
    
    var nbrPredictionsDraw = Model.StatFixturePredictions.Where(s => s.HomePrediction == s.AwayPrediction)
        .Sum(s => s.NumberOfPredictions);

    ViewBag.BreadCrumb = Html.ActionLink("Back to Group Games", "Index", "StatsGroup");
}

<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">Donut Chart</h3>

        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
            <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
        </div>
    </div>
    <div class="box-body chart-responsive">
        <div class="chart" id="sales-chart" style="height: 300px; position: relative;"></div>
    </div>
</div>

<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">Predictions By Score</h3>

        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
            <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
        </div>
    </div>
    <div class="box-body">
        <table class="table table-bordered table-hover" id="fixtures" style="width: 80%" align="center">
            <tr>
                <th>
                    @Model.Fixture.HomeTeam.TeamName
                </th>
                <th>
                    @Model.Fixture.AwayTeam.TeamName
                </th>
                <th>
                    Result
                </th>
                <th>
                    Nbr Of Predictions
                </th>
                <th>
                    Percent
                </th>
            </tr>

            @foreach (var item in Model.StatFixturePredictions)
            {

                var result = Model.Fixture.HomeTeam.TeamName;
                if (item.HomePrediction == item.AwayPrediction)
                {
                    result = "Draw";
                }
                else if (item.AwayPrediction > item.HomePrediction)
                {
                    result = Model.Fixture.AwayTeam.TeamName;
                }
                var percent = Math.Round(Convert.ToDouble(item.NumberOfPredictions) / Convert.ToDouble(nbrPredictions) * 100);
                <tr>
                    <td>
                        @item.HomePrediction
                    </td>
                    <td>
                        @item.AwayPrediction
                    </td>
                    <td>
                        @result
                    </td>
                    <td>
                        @item.NumberOfPredictions
                    </td>
                    <td>
                        @percent%
                    </td>
                </tr>
             }
          </table>
    </div>
</div>


<script src="~/plugins/morris/raphael.min.js"></script>
<script src="~/plugins/morris/morris.min.js"></script>

<script>
    $(function () {
        "use strict";
        //DONUT CHART
        var donut = new Morris.Donut({
            element: 'sales-chart',
            resize: true,
            colors: ["#3c8dbc", "#f56954", "#00a65a"],
            data: [
                { label: "@Model.Fixture.HomeTeam.TeamName", value: @nbrPredictionsHomeWin
    },
        { label: "@Model.Fixture.AwayTeam.TeamName", value: @nbrPredictionsAwayWin },
    { label: "Draw", value: @nbrPredictionsDraw }
            ],
    hideHover: 'auto'
        });
    });
</script>
