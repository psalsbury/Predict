@using Predict.Models
@model Predict.ViewModels.FixturePredictionsViewModel

@{
    ViewBag.Title = "Edit Group Game Predictions";
}

@using (Html.BeginForm("Save", "FixturePredictions"))
{
    <table id="predictions" class="table table-bordered table-hover">
        <thead>
            <tr>

                <th>
                    Group
                </th>

                <th>
                    &nbsp
                </th>
                <th>
                    Home Team
                </th>
                <th>
                    Prediction
                </th>
                <th>
                    Prediction
                </th>
                <th>
                    Away Team
                </th>
                <th>
                    &nbsp;
                </th>
                <th>
                    Fixture Date
                </th>
                <th>
                    Fixture Time
                </th>
            </tr>
        </thead>
        @for (int i = 0; i < Model.FixturePredictions.Count(); i++)
        {
            <tr height="30">
                <div class="form-group">
                    @Html.HiddenFor(m => m.FixturePredictions[i].FixtureId)
                </div>
                <td>
                    &nbsp<b> @Model.EventTeams.Find(m => m.TeamId == @Model.FixturePredictions[i].Fixture.HomeTeam.Id && m.EventId == @Model.FixturePredictions[i].Fixture.EventId).League</b>
                </td>
                <td>
                    <img src="@Url.Content(@Model.FixturePredictions[i].Fixture.HomeTeam.FlagFileLocation)" height="20" />
                </td>
                <td>
                    @Html.DisplayFor(m => m.FixturePredictions[i].Fixture.HomeTeam.TeamName)
                </td>
                <td>
                    <div class="form-group">
                        @Html.TextBoxFor(m => m.FixturePredictions[i].HomePrediction, new { onblur = "IsNumeric(this)", size = "3", maxlength = "3" })
                    </div>
                </td>
                <td>
                    <div class="form-group">
                        @Html.TextBoxFor(m => m.FixturePredictions[i].AwayPrediction, new { onblur = "IsNumeric(this)", size = "3", maxlength = "3" })
                    </div>
                </td>
                <td>
                    @Html.DisplayFor(m => m.FixturePredictions[i].Fixture.AwayTeam.TeamName)
                </td>
                <td>
                    <img src="@Url.Content(@Model.FixturePredictions[i].Fixture.AwayTeam.FlagFileLocation)" height="20" />
                </td>
                <td>
                    @Model.FixturePredictions[i].Fixture.FixtureDateTime.ToShortDateString()
                </td>
                <td>
                    @Model.FixturePredictions[i].Fixture.FixtureDateTime.ToShortTimeString()
                </td>
            </tr>
        }
    </table>


    @Html.AntiForgeryToken()


    <div class="form-group">
        <div>
            <input type="submit" value="Save" class="btn btn-sm btn-default btn-flat pull-left" />
            <input class="btn-sm btn-default btn-flat pull-left" title="Click to select let the computer pick your predictions for you. You can click on 'Reset' to undo your changes if you don't like them!" type="button" value="Lucky Dip" onclick="javascript:LuckyDip()" id="LuckyD" name="LuckyD">
            <input class="btn btn-sm btn-default btn-flat pull-left" type="button" name="Clear" value="Clear" title="Clear all predictions" onclick="javascript:ClearPredictions()" id="Clear">
        </div>
    </div>

    <br />

}

<script>

    function IsNumeric(obj)
    {
        //  check for valid numeric strings
        var strString = obj.value;
        var strValidChars = "0123456789";
        var strChar;
        var blnResult = true;
        if (strString.length == 0) return true; // Nulls are ok

        //  test strString consists of valid characters listed above
        for (i = 0; i < strString.length && blnResult == true; i++) {
            strChar = strString.charAt(i);
            if (strValidChars.indexOf(strChar) == -1) {
                obj.select();
                obj.focus();
                alert('Please enter a numerical value');
                obj.value = "";
                blnResult = false;
            }
        }
        return blnResult;
    }

    function LuckyDip()
    {
        @{
            var position = 0;
            foreach (var fixturePrediction in Model.FixturePredictions)
            {

                var fixtureDateTime = fixturePrediction.Fixture.FixtureDateTime;
                var now = DateTime.Now.ToUniversalTime();
                var info = TimeZoneInfo.FindSystemTimeZoneById("Greenwich Standard Time");
                var localServerTime = DateTimeOffset.Now;
                var isDaylightSaving = info.IsDaylightSavingTime(localServerTime);
                if (isDaylightSaving == true)
                {
                    now = now.AddHours(1);
                }

                var diffInSeconds = (fixtureDateTime - now).TotalSeconds;
                if (diffInSeconds > 0)
                {

                    <text>
                        $('#FixturePredictions_@(position)__HomePrediction')
                            .val(Math.round(Math.random() * 3));
                        $('#FixturePredictions_@(position)__AwayPrediction')
                            .val(Math.round(Math.random() * 3));
                    </text>
                }
                position = position + 1;
            }
        }

    }

    function ClearPredictions() {
        @{
            position = 0;
            foreach (var fixturePrediction in Model.FixturePredictions)
            {

                var fixtureDateTime = fixturePrediction.Fixture.FixtureDateTime;
                var now = DateTime.Now.ToUniversalTime();
                var info = TimeZoneInfo.FindSystemTimeZoneById("Greenwich Standard Time");
                var localServerTime = DateTimeOffset.Now;
                var isDaylightSaving = info.IsDaylightSavingTime(localServerTime);
                if (isDaylightSaving == true)
                {
                    now = now.AddHours(1);
                }

                var diffInSeconds = (fixtureDateTime - now).TotalSeconds;
                if (diffInSeconds > 0)
                {

                    <text>
                        $('#FixturePredictions_@(position)__HomePrediction')
                            .val("");
                        $('#FixturePredictions_@(position)__AwayPrediction')
                            .val("");
                    </text>
                }
                position = position + 1;
            }
        }

    }
</script>



<script>
    $(function () {
        $("#predictions").DataTable( {
            "bLengthChange": false
            , "iDisplayLength": 50
            , "bPaginate": false
        } );;
    });
</script>

