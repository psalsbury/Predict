@model IEnumerable<Predict.ViewModels.StatsKoRoundOf>
@{
    var firstItem = Model.FirstOrDefault();
    var boxName = "Winner";
    var expand = ""; //collapsed-box
    var button = "fa fa-minus"; // fa fa - minus
    var totalPredictions = Model.Sum(a => a.NumberOfPredictions);

    switch (firstItem.RoundOf)
    {
        case 1:
            boxName = "Winner";
            break;
        case 2:
            boxName = "Finalists";
            break;
        case 4:
            boxName = "Semi Finalists";
            break;
        case 8:
            boxName = "Quarter Finalists";
            break;
        case 16:
            boxName = "Last 16";
            break;
    }
}
<div class="box box-solid @expand">

    <div class="box-header with-border">
        <h3 class="box-title">@boxName</h3>
        <div class="box-tools pull-right">
            <button id="pete1" type="button" class="btn btn-box-tool" data-widget="collapse"><i class="@button"></i></button>
        </div>
    </div>

    <div class="box-body">

        <table style="width:100%">
            <tr>
                <td style="vertical-align:top">


                    <div style="width: 300px;float:left" class="box-body chart-responsive">
                        <div class="chart" id="chart_@firstItem.RoundOf" style="height: 300px; position: sticky;">
                        </div>
                    </div>

                </td >
                <td style="vertical-align:top">
                    <table float="right" class="table table-bordered table-hover" id="fixtures_@firstItem.RoundOf" style="width: 80%" align="center">
                        <tr>
                            <th>
                                Team
                            </th>
                            <th>
                                Nbr Of Predictions
                            </th>
                            <th>
                                Percent
                            </th>
                        </tr>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.TeamName
                                </td>
                                <td>
                                    @item.NumberOfPredictions
                                </td>
                                <td>
                                    @(((double)item.NumberOfPredictions / (double)totalPredictions).ToString("0.00%"))
                                </td>
                            </tr>

                        }
                    </table>
                </td>
            </tr>
        </table>


    </div>
</div>
<script>
    $(function () {
        "use strict";
        //DONUT CHART
        var donut = new Morris.Donut({
            element: 'chart_@firstItem.RoundOf',
            resize: true,
            colors: ["#3c8dbc", "#f56954", "#00a65a"],
            data: [
                @{
                    var count = 0;
                    var max = Model.Count();
                    foreach (var item in Model)
                    {
                        var dataItem = "{ label: \"" + item.TeamName + "\", value: " + item.NumberOfPredictions + " }";
                        if (count < max)
                        {
                            dataItem = dataItem + ",";
                        }
                        @Html.Raw(dataItem);
                    }
                }
            ],
            hideHover: 'auto'
        });
    });
</script>
