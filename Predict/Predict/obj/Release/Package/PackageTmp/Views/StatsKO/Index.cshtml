@using System.Web.UI.WebControls
@model Predict.ViewModels.StatsKoViewModel

@{
    ViewBag.Title = @ViewBag.PoolName.ToString() + " Knock Out Prediction Stats";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Home/Index?eventid=@ViewBag.EventId">Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            <a href="/StatsGroup?eventid=@ViewBag.EventId&poolid=@ViewBag.PoolId">@ViewBag.PoolName Game Stats</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">KO Stats</li>
    </ol>
</nav>

@{
    var last16 = Model.StatsKoRoundOfs.Where(a => a.RoundOf == 16).OrderByDescending(a => a.NumberOfPredictions).ThenBy(a => a.TeamName);
    var last8 = Model.StatsKoRoundOfs.Where(a => a.RoundOf == 8).OrderByDescending(a => a.NumberOfPredictions).ThenBy(a => a.TeamName);
    ;
    var last4 = Model.StatsKoRoundOfs.Where(a => a.RoundOf == 4).OrderByDescending(a => a.NumberOfPredictions).ThenBy(a => a.TeamName);
    ;
    var last2 = Model.StatsKoRoundOfs.Where(a => a.RoundOf == 2).OrderByDescending(a => a.NumberOfPredictions).ThenBy(a => a.TeamName);
    ;
    var last1 = Model.StatsKoRoundOfs.Where(a => a.RoundOf == 1).OrderByDescending(a => a.NumberOfPredictions).ThenBy(a => a.TeamName);
    ;
}

@Html.Partial("KoStage", last1)
@Html.Partial("KoStage", last2)
@Html.Partial("KoStage", last4)
@Html.Partial("KoStage", last8)
@Html.Partial("KoStage", last16)

<script>
    $(function() { $('pete1').click(); })

</script>
<script src="~/plugins/morris/raphael.min.js"></script>
<script src="~/plugins/morris/morris.min.js"></script>