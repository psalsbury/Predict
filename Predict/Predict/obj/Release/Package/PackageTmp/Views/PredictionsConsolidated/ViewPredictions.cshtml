@model Predict.ViewModels.PredictionsConsolidatedViewModel

@{
    ViewBag.Title = Model.Player.DisplayName + " Predictions";
}

<div class="nav-tabs-custom">
    <ul class="nav nav-tabs">
        <li class="active"><a href="#tab_1" data-toggle="tab">Fixtures</a></li>
        <li><a href="#tab_2" data-toggle="tab">Knock Out Games</a></li>
        <li><a href="#tab_3" data-toggle="tab">Predicted Group Tables</a></li>
    </ul>
</div>

<div class="tab-content">
    <div class="tab-pane active" id="tab_1">

        @Html.Partial("FixturePredictions", Model.FixturePredictionsViewModel)
    </div>
<!-- /.tab-pane -->
    <div class="tab-pane" id="tab_2">

        @Html.Partial("KoFixturePredictions", Model.KoFixturePredictionViewModel)

    </div>
    
    <div class="tab-pane" id="tab_3">

        @Html.Partial("LeagueTables", Model.LeagueTablesViewModel)

    </div>
</div>  

