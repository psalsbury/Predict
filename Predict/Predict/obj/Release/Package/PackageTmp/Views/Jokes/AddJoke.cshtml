@model Predict.Models.Joke

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Jokes/JokesTable">Jokes</a>
        </li>
    </ol>
</nav>

<div class="box-body">

    @using (Html.BeginForm("AddJoke", "Jokes", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "AddJokeForm" }))
    {
        @Html.AntiForgeryToken()

        if (Model.Id > 0)
        {
            @Html.HiddenFor(a => a.Id);
            @Html.HiddenFor(a => a.CreatedDateTime);
            @Html.HiddenFor(a => a.PlayerId);
        }

        <h4>Submit a new Joke</h4>
        <div class="form-group has-feedback">
            @Html.ValidationSummary("", new { @class = "text-danger" })
        </div>

        <div class="form-group has-feedback">
            @Html.TextAreaFor(m => m.JokeText, new { @class = "form-control", @placeholder = "Joke Text " })
            <span class="glyphicon glyphicon-comment form-control-feedback"></span>
        </div>

        <div class="form-group has-feedback">
            @Html.TextAreaFor(m => m.JokePunchline, new { @class = "form-control", @placeholder = "Joke Punchline" })
            <span class="glyphicon glyphicon-fire form-control-feedback"></span>
        </div>

        <div class="form-group has-feedback">

            <input type="submit" id="btnSubmit" class="btn btn-primary btn-flat" value="@(Model.Id==0 ?"Add Joke" : "Update Joke")" />

        </div>
    }

</div>