@model List<Predict.ViewModels.JokeTable>


<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Jokes/JokesTable">Jokes</a>
        </li>
    </ol>
</nav>

<table class="table">
    <thead>
        <tr>
        <tr style="background-color: #428bca">
            <td style="background-color: #428bca; text-align: center">
                <b>
                    <font color="white">Posn</font>
                </b>
            </td>
            <td>
                <b>
                    <font color="white">Joke</font>
                </b>
            </td>
            <td colspan="2" style="text-align: center">
                <b>
                    <font color="white">Ratings</font>
                </b>
            </td>
        </tr>
        <tr style="background-color: #428bca">
            <td>&nbsp</td>
            <td>&nbsp</td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>Avg Rating</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>Nbr Ratings</b>
            </td>
        </tr>
    </thead>

    @foreach (var tableViewModel in Model)
    {
        <tr style="font-size: larger">
            <td style="text-align: center">
                @tableViewModel.Position.ToString()
            </td>
            <td>
                <a href="~/Jokes/ShowSelectedJoke?id=@tableViewModel.Id" class="product-title">
                    @(tableViewModel.JokeText.Substring(0, tableViewModel.JokeText.Length>=20 ? 20 : tableViewModel.JokeText.Length) + "...")
                </a>
                <br />
            </td>
            <td STYLE="text-align: center">
                @Math.Round(tableViewModel.AvgRating,2).ToString()
            </td>
            <td STYLE="text-align: center">
                @tableViewModel.NbrRatings.ToString()
            </td>
        </tr>
    }

</table>