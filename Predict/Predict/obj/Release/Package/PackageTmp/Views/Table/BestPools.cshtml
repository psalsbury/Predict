@using PagedList.Mvc
@model PagedList.IPagedList<Predict.ViewModels.BestPoolsTableViewModel>


<style>
    table {
        border-collapse: collapse;
        width: 100%;
    }

    th, td {
        padding: 8px;
        text-align: left;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }
</style>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Home/Index?eventid=@ViewBag.EventId">Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@ViewBag.PoolName table</li>
    </ol>
</nav>

<table class="table" style='font-size: 12px;'>
    <thead>
        <tr>
        <tr style="background-color: #428bca">
            <td style="background-color: #428bca; text-align: center">
                <b>
                    <font color="white">Posn</font>
                </b>
            </td>
            <td>
                <b>
                    <font color="white">League</font>
                </b>
            </td>
            <td colspan="4" style="text-align: center">
                <b>
                    <font color="white">Average Points</font>
                </b>
            </td>
        </tr>
        <tr style="background-color: #428bca">
            <td>&nbsp</td>
            <td>&nbsp</td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>CS</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>CR</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>KO</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>Total</b>
            </td>
        </tr>
    </thead>

    @foreach (var tableViewModel in Model)
    {
        <tr style="font-size: larger">
            <td style="text-align: center">
                @tableViewModel.PoolPosition.ToString()
            </td>
            <td>
                <a href="~/Table/ShowTable?eventid=@ViewBag.EventId&poolid=@tableViewModel.PoolId" class="product-title">
                    @tableViewModel.PoolName
                </a>
                <br />
                <i>@tableViewModel.NbrOfMembers member@(@tableViewModel.NbrOfMembers>1?"s":"") </i>
            </td>
            <td STYLE="text-align: center">
                @tableViewModel.CorrectScore.ToString()
            </td>
            <td STYLE="text-align: center">
                @tableViewModel.CorrectResult.ToString()
            </td>
            <td STYLE="text-align: center">
                @tableViewModel.KoScore.ToString()
            </td>
            <td STYLE="text-align: center">
                @tableViewModel.TotalScore.ToString()
            </td>
        </tr>
    }

</table>
<br />
Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("BestPools",
    new { ViewBag.EventId, page }))