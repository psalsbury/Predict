@model Predict.ViewModels.StatsFixtureViewModel

@{
    ViewBag.Title = Model.Fixture.HomeTeam.TeamName + " vs " + Model.Fixture.AwayTeam.TeamName;
    var nbrPredictions = Model.StatFixturePredictions.Sum(s => s.NumberOfPredictions);

    var nbrPredictionsHomeWin = Model.StatFixturePredictions.Where(s => s.HomePrediction > s.AwayPrediction)
        .Sum(s => s.NumberOfPredictions);

    var nbrPredictionsAwayWin = Model.StatFixturePredictions.Where(s => s.HomePrediction < s.AwayPrediction)
        .Sum(s => s.NumberOfPredictions);

    var nbrPredictionsDraw = Model.StatFixturePredictions.Where(s => s.HomePrediction == s.AwayPrediction)
        .Sum(s => s.NumberOfPredictions);

    var international = false;

    if (Model.International)
    {
        international = true;
    }
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Home/Index?eventid=@Model.EventId">Home</a>
        </li>
        <li class="breadcrumb-item">
            <a href="../../StatsGroup?eventid=@Model.EventId&poolid=@ViewBag.PoolId">@ViewBag.PoolName Game Stats</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Data</li>
    </ol>
</nav>

<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">Donut Chart</h3>

        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
            <button type="button" class="btn btn-box-tool" data-widget="remove">
                <i class="fa fa-times"></i>
            </button>
        </div>
    </div>
    <div class="box-body chart-responsive">
        <div class="chart" id="sales-chart" style="height: 300px; position: relative;"></div>
    </div>
</div>


<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">Predictions By Result</h3>

        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
            <button type="button" class="btn btn-box-tool" data-widget="remove">
                <i class="fa fa-times"></i>
            </button>
        </div>
    </div>
    <div class="box-body">
        <table class="table table-bordered table-hover" id="fixturesByResult" style="width: 100%" align="center">
            <tr>
                <th>
                    &nbsp;
                </th>
                <th>
                    Result
                </th>
                <th>
                    Qty
                </th>
                <th>
                    %
                </th>
            </tr>

            <tr>
                <td>
                    <img src="@Url.Content(@Model.Fixture.HomeTeam.FlagFileLocation)" height="20" @(international?"width=32":"") />
                </td>
                <td>
                    <b>@Model.Fixture.HomeTeam.TeamName</b> to win
                </td>
                <td>
                    @nbrPredictionsHomeWin
                </td>
                <td>
                    @Math.Round(Convert.ToDouble(nbrPredictionsHomeWin) / Convert.ToDouble(nbrPredictions) * 100) %
                </td>
            </tr>

            <tr>
                <td>
                    <img src="@Url.Content(@Model.Fixture.AwayTeam.FlagFileLocation)" height="20" @(international?"width=32":"") />
                </td>
                <td>
                    <b>@Model.Fixture.AwayTeam.TeamName</b> to win
                </td>
                <td>
                    @nbrPredictionsAwayWin
                </td>
                <td>
                    @Math.Round(Convert.ToDouble(nbrPredictionsAwayWin) / Convert.ToDouble(nbrPredictions) * 100) %
                </td>
            </tr>

            <tr>
                <td>
                    &nbsp;
                </td>
                <td>
                    <b>Draw</b>
                </td>
                <td>
                    @nbrPredictionsDraw
                </td>
                <td>
                    @Math.Round(Convert.ToDouble(nbrPredictionsDraw) / Convert.ToDouble(nbrPredictions) * 100) %
                </td>
            </tr>

        </table>
    </div>
</div>


<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">Predictions By Score</h3>

        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
            <button type="button" class="btn btn-box-tool" data-widget="remove">
                <i class="fa fa-times"></i>
            </button>
        </div>
    </div>
    <div class="box-body">
        <table class="table table-bordered table-hover" id="fixtures" style="width: 100%" align="center">
            <tr>
                <th style="text-align:center" >
                    <div class="hidden-xs hidden-sm">@Model.Fixture.HomeTeam.TeamName</div>
                    <img src="@Url.Content(@Model.Fixture.HomeTeam.FlagFileLocation)" height="20" @(international?"width=32":"") />
                </th>
                <th style="text-align:center" >
                    <div style="align-content: center" class="hidden-xs hidden-sm">@Model.Fixture.AwayTeam.TeamName</div>
                    <img src="@Url.Content(@Model.Fixture.AwayTeam.FlagFileLocation)" height="20" @(international?"width=32":"") />
                </th>
                <th>
                    Result
                </th>
                <th>
                    Qty
                </th>
                <th>
                    %
                </th>
            </tr>

            @foreach (var item in Model.StatFixturePredictions)
            {
                var result = Model.Fixture.HomeTeam.TeamName;
                if (item.HomePrediction == item.AwayPrediction)
                {
                    result = "Draw";
                }
                else if (item.AwayPrediction > item.HomePrediction)
                {
                    result = Model.Fixture.AwayTeam.TeamName;
                }
                var percent = Math.Round(Convert.ToDouble(item.NumberOfPredictions) / Convert.ToDouble(nbrPredictions) * 100);
                <tr>
                    <td style="text-align:center">
                        @item.HomePrediction
                    </td>
                    <td style="text-align:center">
                        @item.AwayPrediction
                    </td>
                    <td>
                        <b>@result</b>
                    </td>
                    <td>
                        @item.NumberOfPredictions
                    </td>
                    <td>
                        @percent%
                    </td>
                </tr>
            }
        </table>
    </div>
</div>

<script src="~/plugins/morris/raphael.min.js"></script>
<script src="~/plugins/morris/morris.min.js"></script>

<script>
    $(function() {
        "use strict";
        //DONUT CHART
        var donut = new Morris.Donut({
            element: 'sales-chart',
            resize: true,
            colors: ["#3c8dbc", "#f56954", "#00a65a"],
            data: [
                { label: "@Model.Fixture.HomeTeam.TeamName", value: @nbrPredictionsHomeWin },
                { label: "@Model.Fixture.AwayTeam.TeamName", value: @nbrPredictionsAwayWin },
                { label: "Draw", value: @nbrPredictionsDraw }
            ],
            hideHover: 'auto'
        });
    });
</script>