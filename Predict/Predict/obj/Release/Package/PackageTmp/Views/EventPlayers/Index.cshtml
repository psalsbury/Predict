@using Microsoft.AspNet.Identity
@using Predict.Models
@using System.Linq;
@model IEnumerable<Predict.Models.Event>

@{
    var eventPlayers = (List<EventPlayer>)Session["EventPlayers"];
    var playerId = User.Identity.GetUserId();
    ViewBag.Title = "Your Comps";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">Your Comps</li>
    </ol>
</nav>

@using (Html.BeginForm("Save", "EventPlayers"))
{
    <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
            <li class="active" onclick="myFunction(true)">
                <a href="#tab_1" data-toggle="tab">Upcoming/Active</a>
            </li>
            <li onclick="myFunction(false)">
                <a href="#tab_2" data-toggle="tab">Completed</a>
            </li>
        </ul>
    </div>


    <div class="tab-content">
        <div class="tab-pane active" id="tab_1">

            <table id="EventPlayers" class="table table-hover">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.EventName)
                    </th>
                    <th>Join</th>
                    <th>&nbsp;</th>
                </tr>

                @foreach (var item in Model.Where(e => e.EndDateTime >= DateTime.UtcNow).OrderBy(a => a.StartDateTime))
                {
                    <tr height="60">
                        <td>
                            @Html.DisplayFor(modelItem => item.EventName)
                        </td>
                        <td>
                            @{ var exists = eventPlayers.Exists(a => a.EventId == item.Id); }

                            <input type="checkbox" value="@item.Id" id="event_@item.Id" name="event_@item.Id" @(exists ? "checked" : "") )>

                        </td>
                        <td>
                            @if (exists)
                            {
                            <a class="btn btn-info" href='@Url.Action("Index", "Home", new { eventId = item.Id})'>
                                <i class="fa fa-home"></i>&nbsp; Home
                            </a>
                            }
                        </td>
                    </tr>
                }
            </table>

        </div>
        <div class="tab-pane" id="tab_2">

            <table class="table table-hover" id="EventPlayers2">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.EventName)
                    </th>
                    <th>End Date</th>
                    <th>&nbsp;</th>
                </tr>

                @foreach (var item in Model.Where(e => e.EndDateTime < DateTime.UtcNow).OrderByDescending(a => a.EndDateTime))
                {
                    var exists = eventPlayers.Exists( a => a.EventId == item.Id);
                    if (exists)
                    {
                        <tr height="60">
                            <td>
                                @Html.DisplayFor(modelItem => item.EventName)
                            </td>
                            <td>
                                @item.EndDateTime.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <a class="btn btn-info" href='@Url.Action("Index", "Home", new { eventId = item.Id})'>
                                    <i class="fa fa-home"></i>&nbsp; Home
                                </a>
                            </td>
                        </tr>
                    }
                }
            </table>

        </div>
    </div>


    <div id="myDIV">
        @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
        <input type="submit" id="save" value="Save" class="btn btn-success alignleft" />

        <input type="button"
               id="add"
               value="Add/Edit Comps"
               class="btn btn-primary alignright"
               onclick="location.href = '@Url.Action("EventsIndex", "Events") '" />

    </div>
    <br/>
    <p>
        This screen allows you to join prediction comps such as Euro 2021, or the premier league (when fixtures are available). From here you can also create your own unique comp by selecting your own fixtures that you would like to predict
    </p>
}
<script>
    function myFunction(showButton) {
        var x = document.getElementById("myDIV");
        if (showButton === true) {
            x.style.display = "block";
        } else {
            x.style.display = "none";
        }
    }

    $(document).ready(function() {
        $('#EventPlayers').DataTable();
    });

    $(document).ready(function() {
        $('#EventPlayers2').DataTable();
    } );
</script>
