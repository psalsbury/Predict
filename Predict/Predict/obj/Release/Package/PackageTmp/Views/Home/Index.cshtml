@model Predict.Models.EventPlayer
<div class="style:">
    @if (Context.User.Identity.IsAuthenticated && Model != null)
    {
        @Html.Partial("LoggedOn")
    }
    else if (Context.User.Identity.IsAuthenticated && Model == null)
    {
        @Html.Partial("LoggedOnNoEvents")
    }
    else
    {
        @Html.Partial("NotLoggedOn")
    }
</div>