@using Microsoft.Ajax.Utilities
@using Predict.Models
@using Predict.ViewModels
@model Predict.Models.EventPlayer
<link rel="stylesheet" href="~/Content/css/ionicons.min.css">
@{

    var eventPlayer = Model;
    var eventId = eventPlayer.EventId;

    if (eventId > 0)
    {
        var poolInfoViewModels = ((List<PoolInfoViewModel>)Session["PoolInfo"]).Where(a => a.EventId == eventId);

        <text>
            <h3>@eventPlayer.Event.EventName - Home</h3>
        </text>

        var nbrFixturePredictionsToEnter = (int)Session["nbrFixtures*" + eventId];
        var nbrKoPredictionsToEnter = (int)Session["nbrKoFixtures*" + eventId] * 2 + 1;
        if ((int)Session["nbrKoFixtures*" + eventId] == 0)
        {
            nbrKoPredictionsToEnter = 0;
        }
        ;
        var nbrBonusQuestionsToEnter = (int)Session["nbrBonusQuestions*" + eventId];
        ;

        var nbrFixturePredictionsEntered = (int)Session["nbrFixturePredictions*" + eventId];
        var nbrKoPredictionsEntered = (int)Session["nbrKoPredictions*" + eventId] + (int)Session["nbrWinningTeamPredictions*" + eventId];
        var nbrBonusQuestionPredictionsEntered = (int)Session["nbrBonusQuestionPredictions*" + eventId];

        var bonusPredictionBox = "green";
        if (nbrBonusQuestionPredictionsEntered == 0)
        {
            bonusPredictionBox = "red";
        }
        else if (nbrBonusQuestionsToEnter > nbrBonusQuestionPredictionsEntered)
        {
            bonusPredictionBox = "yellow";
        }

        var fixturePredictionBox = "green";
        if (nbrFixturePredictionsEntered == 0)
        {
            fixturePredictionBox = "red";
        }
        else if (nbrFixturePredictionsToEnter > nbrFixturePredictionsEntered)
        {
            fixturePredictionBox = "yellow";
        }

        var koPredictionBox = "green";
        if (nbrKoPredictionsEntered == 0)
        {
            koPredictionBox = "red";
        }
        else if (nbrKoPredictionsToEnter > nbrKoPredictionsEntered)
        {
            koPredictionBox = "yellow";
        }
        var firstPass = true;

        <div class="row">


            @if (nbrFixturePredictionsToEnter > 0)
            {

                <div class="col-lg-3 col-xs-6">
                    <!-- small box -->
                    <div class="small-box bg-@fixturePredictionBox">
                        <div class="inner">
                            <h3>
                                @nbrFixturePredictionsEntered <sup style="font-size: 20px"> out of @nbrFixturePredictionsToEnter</sup>
                            </h3>
                            <p>Group games predicted</p>
                        </div>
                        <div class="icon">
                            <i class="ion ion-ios-football-outline"></i>
                        </div>
                        <a href="~/FixturePredictions/FixturePredictions/@eventId" class="small-box-footer">
                            Enter them here <i class="fa fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
            }
            @if (nbrKoPredictionsToEnter > 0)
            {
                <div class="col-lg-3 col-xs-6">
                    <!-- small box -->
                    <div class="small-box bg-@koPredictionBox">
                        <div class="inner">
                            <h3>
                                @nbrKoPredictionsEntered <sup style="font-size: 20px"> out of @nbrKoPredictionsToEnter</sup>
                            </h3>
                            <p>KO Predictions entered</p>
                        </div>
                        <div class="icon">
                            <i class="ion ion-stats-bars"></i>
                        </div>
                        <a href="~/KOFixturePredictions/KOFixturePredictionsGrouped/@eventId" class="small-box-footer">
                            Enter them here <i class="fa fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
            }
            @if (nbrBonusQuestionsToEnter > 0)
            {
                <div class="col-lg-3 col-xs-6">
                    <!-- small box -->
                    <div class="small-box bg-@bonusPredictionBox">
                        <div class="inner">
                            <h3>
                                @nbrBonusQuestionPredictionsEntered <sup style="font-size: 20px"> out of @nbrBonusQuestionsToEnter</sup>
                            </h3>
                            <p>Bonus Predictions entered</p>
                        </div>
                        <div class="icon">
                            <i class="ion ion-stats-bars"></i>
                        </div>
                        <a href="~/BonusQuestionPredictions/BonusQuestionPredictions/@eventId" class="small-box-footer">
                            Enter them here <i class="fa fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
            }
            <div class="col-lg-3 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-blue">
                    <div class="inner">
                        <p style="font-size: 30px">
                            Game Info
                        </p>
                        <p>See whos predicted what</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-pie-graph"></i>
                    </div>
                    <a href="@Url.Action("Index", "StatsGroup", new {eventId = eventPlayer.EventId})" class="small-box-footer">
                        See them here <i class="fa fa-arrow-circle-right"></i>
                    </a>

                </div>
            </div>

        </div>



        foreach (var poolInfoViewModel in poolInfoViewModels)
        {
            var collapsedBox = "";
            var image = "fa-minus";
            if (!firstPass)
            {
                collapsedBox = "collapsed-box";
                image = "fa-plus";

            }

            <div class="box box-primary @collapsedBox">
                <div class="box-header with-border">
                    <h3 class="box-title">
                        <b>@poolInfoViewModel.PoolName</b> Details

                        @if (poolInfoViewModel.IsAdmin)
                        {
                            @:<b>(@poolInfoViewModel.PlayersToApprove to approve)</b>
                        }
                    </h3>

                    <div class="box-tools pull-right">
                        <button type="button" class="btn btn-box-tool" data-widget="collapse">
                            <i class="fa @image"></i>
                        </button>
                    </div>
                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <ul class="products-list product-list-in-box">
                        <li class="item">
                            <span class="info-box-icon bg-yellow">
                                <i class="ion ion-ios-people-outline"></i>
                            </span>
                            <div class="info-box-content">

                                <span class="info-box-text">Nbr of Members</span>
                                <span class="info-box-number">@poolInfoViewModel.TotalNumberOfPlayers</span>

                            </div>
                        </li>

                        <!-- /.item -->
                        <li class="item">
                            <span class="info-box-icon bg-blue">
                                <i class="ion ion-ios-football-outline"></i>
                            </span>
                            <div class="info-box-content">
                                <a href="~/Table/ShowTable?eventid=@eventId&poolid=@poolInfoViewModel.PoolId" class="product-title">
                                    <span class="info-box-text">Position</span>

                                    <span class="label label-info pull-right">View Table</span>

                                    @if (poolInfoViewModel.PoolPosition == 0)
                                    {
                                        <span class="info-box-number">(not started)</span>
                                    }
                                    else
                                    {
                                        <span class="info-box-number">@poolInfoViewModel.PoolPosition</span>
                                    }

                                </a>
                            </div>

                        </li>
                        <!-- /.item -->
                        <li class="item">
                            <span class="info-box-icon bg-red">
                                <i class="ion ion-ios-circle-outline"></i>
                            </span>
                            <div class="info-box-content">

                                <span class="info-box-text">total Score</span>
                                <span class="info-box-number">@poolInfoViewModel.TotalScore</span>

                            </div>
                        </li>
                        <!-- /.item -->
                    </ul>
                </div>
            </div>

            firstPass = false;
        }

    }
}
