@using Microsoft.AspNet.Identity
@using Predict.Models
@model Predict.ViewModels.EventFixturesViewModel
@{
    ViewBag.Title = Model.Event.EventName + " Fixtures";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Events/EventsIndex">Comps Home</a>
        </li>
        <li class="breadcrumb-item">
            <a href="/Events/EventsIndex">Comps List</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Add Fixtures</li>
    </ol>
</nav>

@using (Html.BeginForm("GetFixturesForLeague", "EventFixtures"))
{
    @Html.HiddenFor(m => m.Event.Id)
    <div class="row">
        <select name="LeagueId" id="LeagueId" class="form-control" onchange="this.form.submit()">
            <option value="0"> Select League.. </option>
            @if (Model.Leagues != null)
            {
                foreach (var item in Model.Leagues)
                {
                    <option value="@item.Id" @(item.Id == Model.LeagueId ? "selected" : "")> @item.LeagueName </option>
                }
            }
        </select>

        @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
    </div>
}

<input class="form-control" id="myInput" type="text" placeholder="Search..">

@if (Model.Fixtures != null && Model.Fixtures.Count > 0)
{
    <br />
    <text>Click on <b style="font-size:larger;">+</b> or <b style="font-size:larger;">-</b> to add/ remove fixtures to your Comp</text>
    <br />
    <br />
    <table id="EventFixtures" class="table table-bordered table-hover no-gutters">
        @foreach (var item in Model.Fixtures.ToList())
        {

            var exists = false;
            if (Model.EventFixtures != null && Model.EventFixtures.Count > 0)
            {
                exists = Model.EventFixtures.Exists(a => a.FixtureId == item.Id);
            }

            <tr class="fixture">
                <td style="vertical-align: middle;" class="row no-gutters">
                    @if (exists)
                    {
                        <button class="btn btn-danger js-delete btn-sm" value="Add" dataFixtureId="@item.Id" dataEventId="@Model.Event.Id"><i class="fa fa-minus"></i></button>
                    }
                    else
                    {
                        <button class="btn btn-success js-add btn-sm" value="Add" dataFixtureId="@item.Id" dataEventId="@Model.Event.Id"><i class="fa fa-plus"></i></button>
                    }
                </td>

                <td style="text-align: left; vertical-align: middle;" witdth="50%">
                    <div class="container-fluid">
                        <div class="row vertical-middle text-center">
                            <div class="col-sm-6 text-left ; row no-gutters">
                                <table width="100%" cellpadding="0">
                                    <tr>
                                        <td border="1" width="15%">
                                            <img src="@Url.Content(item.HomeTeam.FlagFileLocation)" height="20" />
                                        </td>
                                        <td style="text-align: left">
                                            &nbsp;
                                            @item.HomeTeam.TeamName
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-sm-6 text-left ; row no-gutters">
                                <table width="100%">
                                    <tr>
                                        <td border="1" width="15%">
                                            <img src="@Url.Content(item.AwayTeam.FlagFileLocation)" height="20" />
                                        </td>
                                        <td style="text-align: left">
                                            &nbsp;
                                            @item.AwayTeam.TeamName
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </td>

                <td style="text-align: center; vertical-align: middle;" witdth="25%" class="myDate">
                    @Html.Hidden("FixtureDateTime", item.FixtureDateTime.ToLongDateString() + " " + item.FixtureDateTime.ToShortTimeString())
                </td>
            </tr>
        }
    </table>

    <script>

        $(document).ready(function () {
            $("#myInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".fixture").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });

    </script>

}
else
{
    <h1>Select league to add fixtures..</h1>
    <br />
    <br />
    <h4>If there are any countries/leagues you would like including, please contact us <a href="@Url.Action("ContactUs", "Home")">here</a></h4>
}

<input type="button"
       value="All Done"
       class="btn btn-success"
       onclick="location.href = '@Url.Action("CompsDashboardIndex", "CompsDashboard") '" />

<script>
    $("#EventFixtures").on("click",
        ".js-add",
        function () {
            var button = $(this);
            $(button.html("<i class='fa fa-refresh fa-spin'></i>"));
            $.ajax(
                {
                    url: "../api/EventFixtures/Add/" + button.attr("dataEventId") + "/" + button.attr("dataFixtureId"),
                    method: "POST",
                    success: function () {
                        $(button.attr('class', 'btn btn-danger js-delete btn-sm'));
                        $(button.html("<i class='fa fa-minus'></i>"));
                    },
                    error: function (request, error) {
                        $(button.attr('class', 'btn btn-success js-add btn-sm'));
                        $(button.html("<i class='fa fa-plus'></i>"));
                    }
                });
        });


    $("#EventFixtures").on("click",
        ".js-delete",
        function () {
            var button = $(this);
            $(button.html("<i class='fa fa-refresh fa-spin'></i>"));
            $.ajax(
                {
                    url: "../api/EventFixtures/Delete/" + button.attr("dataEventId") + "/" + button.attr("dataFixtureId"),
                    method: "POST",
                    success: function () {
                        $(button.attr('class', 'btn btn-success js-add btn-sm'));
                        $(button.html("<i class='fa fa-plus'></i>"));
                    },
                    error: function () {
                        $(button.attr('class', 'btn btn-danger js-delete btn-sm'));
                        $(button.html("<i class='fa fa-minus'></i>"));
                    }
                });
        });

</script>

<script>

    $(document).ready(function () {
        $('#EventFixtures').DataTable({
            'columnDefs':
                [
                    {
                        'targets': [3], /* column index */
                        "type": "date-eu"
                    }

                ]
            , "paging": false
        });
    });

</script>

<script>

    //get all td with actionclass in table
    $("tbody tr td.myDate").each(function () {

        $hiddenValue = $(this).find("input[type=hidden]").val();

        var d = new Date($hiddenValue);

        this.innerHTML = convertUTCDateToLocalDate(d);

    });

    function convertUTCDateToLocalDate(date) {
        var newDate = new Date(date.getTime() + date.getTimezoneOffset() * 60 * 1000);

        var offset = date.getTimezoneOffset() / 60;
        var hours = date.getHours();

        newDate.setHours(hours - offset);
        mo = new Intl.DateTimeFormat('en', { month: 'short' }).format(newDate);
        da = new Intl.DateTimeFormat('en', { day: '2-digit' }).format(newDate);

        return da + ' ' + mo + ' ' + pad(newDate.getHours(), 2) + ':' + pad(newDate.getMinutes(), 2);

    }

    function pad(n, width, z) {
        z = z || '0';
        n = n + '';
        return n.length >= width ? n : new Array(width - n.length + 1).join(z) + n;
    }

</script>

