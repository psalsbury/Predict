@using Microsoft.AspNet.Identity
@using Predict.Models
@model Predict.ViewModels.EventFixturesViewModel

@using (Html.BeginForm("Save", "EventFixtures"))

{
    @Html.HiddenFor(m => m.Event.Id);
    <table  id="EventFixtures" class="table table-bordered table-hover">

        <thead>
        <tr>
            <th></th>
            <th>League</th>
            <th>Home Team</th>
            <th>Away Team</th>
            <th>Date</th>
        </tr>
            </thead>
        @foreach (var item in Model.Fixtures.ToList())
        {
            var exists = Model.EventFixtures.Exists(a => a.FixtureId == item.Id);
            if (exists || item.FixtureDatePassed == false)
            {
                <tr>
                    <td>
                        <input type="checkbox" value="@item.Id" id="fixture_@item.Id" name="fixture_@item.Id" @(exists ? "checked" : "")>
                    </td>
                    <td>
                        @item.League.ShortLeagueName
                    </td>
                    <td>
                        @item.HomeTeam.TeamName
                    </td>
                    <td>
                        @item.AwayTeam.TeamName
                    </td>
                    <td>
                        @item.FixtureDateTime.ToString("yyyy-MM-dd h:mm tt")
                    </td>
                </tr>
            }
        }
        <tfoot>
        <tr>
            <th></th>
            <th>League</th>
            <th>Home Team</th>
            <th>Away Team</th>
            <th>Date</th>
        </tr>
        </tfoot>
    </table>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
            <input type="submit" value="Save" class="btn btn-success" />
        </div>
    </div>

}


<script>


    $(document).ready(function() {
        $('#EventFixtures').DataTable( {
            'columnDefs': [
                {
                    'targets': [4], /* column index */
                    "type": "date-eu"
                }

            ]
            , 'pageLength': 25,

            initComplete: function () {
                this.api().columns().every( function () {
                    var column = this;
                    var select = $('<select><option value=""></option></select>')
                        .appendTo( $(column.footer()).empty() )
                        .on( 'change', function () {
                            var val = $.fn.dataTable.util.escapeRegex(
                                $(this).val()
                            );
 
                            column
                                .search( val ? '^'+val+'$' : '', true, false )
                                .draw();
                        } );
 
                    column.data().unique().sort().each( function ( d, j ) {
                        select.append('<option value="' + d + '">' + d + '</option>');
                    } );
                } );
            }
        } );
    } );

    var table = $('#EventFixtures').DataTable({
        // ... skipped ...
    });

    $('form').on('submit', function(e){
        var $form = $(this);

        // Iterate over all checkboxes in the table
        table.$('input[type="checkbox"]').each(function(){
            // If checkbox doesn't exist in DOM
            if(!$.contains(document, this)){
                // If checkbox is checked
                if(this.checked){
                    // Create a hidden element 
                    $form.append(
                        $('<input>')
                        .attr('type', 'hidden')
                        .attr('name', this.name)
                        .val(this.value)
                    );
                }
            } 
        });          
    });

</script>