@model List<Predict.ViewModels.QuizTable>

@{
    var posn = 0;
}

<table class="table" style='font-size: 12px;'>
    <thead>
        <tr>
        <tr style="background-color: #428bca">
            <td style="background-color: #428bca; text-align: center">
                <b>
                    <font color="white">Posn</font>
                </b>
            </td>
            <td>
                <b>
                    <font color="white">Player</font>
                </b>
            </td>
            <td colspan="4" style="text-align: center">
                <b>
                    <font color="white">Breakdown</font>
                </b>
            </td>
        </tr>
        <tr style="background-color: #428bca">
            <td>&nbsp</td>
            <td>&nbsp</td>
            <td STYLE="color: WHITE; text-align: center;">
                <b class="hidden-xs">Answered</b>
                <b class="visible-xs">Ans</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b class="hidden-xs">Correct</b>
                <b class="visible-xs">Crct</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b class="hidden-xs">Available</b>
                <b class="visible-xs">Avail</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>Score</b>
            </td>
        </tr>
    </thead>

    @foreach (var tableViewModel in Model)
    {
        posn += 1;
<tr style="font-size: larger">
    <td style="text-align: center">
        @posn
    </td>
    <td>
        @tableViewModel.PlayerName
    </td>
    <td STYLE="text-align: center">
        @tableViewModel.QuestionsAnswered
    </td>
    <td STYLE="text-align: center">
        @tableViewModel.QuestionsCorrect
    </td>
    <td STYLE="text-align: center">
        @tableViewModel.QuestionsAvailable
    </td>
    <td STYLE="text-align: center">
        @(Math.Round(tableViewModel.Score,2) * 100)
    </td>
</tr>
    }

</table>