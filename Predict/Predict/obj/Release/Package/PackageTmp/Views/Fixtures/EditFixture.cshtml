@model Predict.ViewModels.FixtureViewModel

@{
    ViewBag.Title = "Edit Fixture";
}

@using (Html.BeginForm("Save", "Fixtures"))

{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true, "", new {@class = "text-danger"})
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.LeagueId)

        <div id="picker"> </div>
        <input type="hidden" id="result" value="">

        <div class="form-group">
            @Html.LabelFor(model => model.FixtureDateTime, new {@class = "control-label col-md-2"})
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.FixtureDateTime, new {@class = "form-control"})
                @Html.ValidationMessageFor(m => m.FixtureDateTime, "", new {@class = "text-danger"})
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HomeTeamId, new {@class = "control-label col-md-2"})
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.HomeTeamId, new SelectList(Model.Teams, "Id", "TeamName"), "Select Home Team", new {@class = "form-control"})
                @Html.ValidationMessageFor(m => m.HomeTeamId, "", new {@class = "text-danger"})
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.AwayTeamId, new {@class = "control-label col-md-2"})
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.AwayTeamId, new SelectList(Model.Teams, "Id", "TeamName"), "Select Away Team", new {@class = "form-control"})
                @Html.ValidationMessageFor(model => model.AwayTeamId, "", new {@class = "text-danger"})
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HomeResult, new {@class = "control-label col-md-2"})
            <div class="col-md-10">
                @Html.EditorFor(model => model.HomeResult, new {htmlAttributes = new {@class = "form-control"}})
                @Html.ValidationMessageFor(model => model.HomeResult, "", new {@class = "text-danger"})
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.AwayResult, new {@class = "control-label col-md-2"})
            <div class="col-md-10">
                @Html.EditorFor(model => model.AwayResult, new {htmlAttributes = new {@class = "form-control"}})
                @Html.ValidationMessageFor(model => model.AwayResult, "", new {@class = "text-danger"})
            </div>
        </div>

        @if (Model.Id != 0)
        {
            <div class="form-group">
                @Html.LabelFor(model => model.CreatedDateTime, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.CreatedDateTime, new {htmlAttributes = new {@class = "form-control", disabled = "disabled"}})
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.ModifiedDateTime, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.ModifiedDateTime, new {htmlAttributes = new {@class = "form-control", disabled = "disabled"}})
                </div>
            </div>
        }
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
                <input type="submit" value="Save" class="btn btn-default"/>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section scripts
{
    @*
        Add this for client side validation. It will hook into the same code as the server side validation
    *@

    @Scripts.Render("~/bundles/jqueryval")
}