@model IEnumerable<Predict.Models.Fixture>

@{
    ViewBag.Title = "Fixture List";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Home/Index?eventid=@ViewBag.EventId">Home</a>
        </li>
        <li class="breadcrumb-item">
            <a href="/Admin/AdminHome?EventId=@ViewBag.EventId">Admin Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Fixture List</li>
    </ol>
</nav>
<p>
    @Html.ActionLink("Create New", "Create", new { eventId = ViewBag.EventId })
</p>




<table id="groupresults" name="groupresults" class="table table-bordered table-hover">
    <thead>
        <tr>

            <th style="text-align: center; vertical-align: middle;">Game</th>
            <th style="text-align: center; vertical-align: middle;">
                Fixture Date/Time
            </th>
            <th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>

            <td style="text-align: center; vertical-align: middle;" witdth="50%">
                <div class="container-fluid">
                    <div class="row vertical-middle text-center">
                        <div class="col-sm-6 text-center">
                            <table width="100%" cellpadding="2">
                                <tr>
                                    <td width="20%">
                                        <img src="@Url.Content(item.HomeTeam.FlagFileLocation)" height="20" />
                                    </td>
                                    <td style="text-align: left" width="60%">
                                        &nbsp
                                        @Html.DisplayFor(modelItem => item.HomeTeam.TeamName)
                                    </td>
                                    <td style="text-align: left" width="20%">
                                        @Html.DisplayFor(modelItem => item.HomeResult, new { @class = "control-label col-md-2" })
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="col-sm-6 text-center">
                            <table width="100%" cellpadding="2">
                                <tr>
                                    <td width="20%">
                                        <img src="@Url.Content(item.AwayTeam.FlagFileLocation)" height="20" />
                                    </td>
                                    <td style="text-align: left" width="60%">
                                        &nbsp
                                        @Html.DisplayFor(modelItem => item.AwayTeam.TeamName)
                                    </td>
                                    <td style="text-align: left" width="20%">
                                        @Html.DisplayFor(modelItem => item.AwayResult, new { @class = "control-label col-md-2" })
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </td>

            <td style="text-align: center; vertical-align: middle;" witdth="25%" class="myDate">
                @Html.Hidden("FixtureDateTime", item.FixtureDateTime.ToLongDateString() + " " + item.FixtureDateTime.ToShortTimeString())

            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id })
            </td>

        </tr>
    }
</table>

<script>

    $(function () {
        $("#fixtures").DataTable({
            "bLengthChange": false
        });;
    });



</script>


<script>

    //get all td with actionclass in table
    $("tbody tr td.myDate").each(function () {

        $hiddenValue = $(this).find("input[type=hidden]").val();

        var d = new Date($hiddenValue);

        this.innerHTML = convertUTCDateToLocalDate(d);

    });

    function convertUTCDateToLocalDate(date) {
        var newDate = new Date(date.getTime() + date.getTimezoneOffset() * 60 * 1000);

        var offset = date.getTimezoneOffset() / 60;
        var hours = date.getHours();

        newDate.setHours(hours - offset);
        mo = new Intl.DateTimeFormat('en', { month: 'short' }).format(newDate);
        da = new Intl.DateTimeFormat('en', { day: '2-digit' }).format(newDate);

        return da + ' ' + mo + ' ' + newDate.getHours() + ':' + pad(newDate.getMinutes(), 2);

    }

    function pad(n, width, z) {
        z = z || '0';
        n = n + '';
        return n.length >= width ? n : new Array(width - n.length + 1).join(z) + n;
    }

</script>