@using Microsoft.AspNet.Identity
@using Predict.Helper
@using Predict.Models
<header class="main-header">
    @* BEGIN Logo *@
    <a href="@Url.Action("Index", "Home")" class="logo">
        @* Mini logo for sidebar 50x50 pixels *@
        <span class="logo-mini"><b>PC</b></span>
        @* Logo for regular state and mobile devices *@
        <span class="logo-lg">
            <b>Prediction Comp</b>
        </span>
    </a>

    <nav class="navbar navbar-static-top" role="navigation">
        <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
            <span class="sr-only">Toggle navigation</span>
        </a>
        <div class="navbar-custom-menu">

            <ul class="nav navbar-nav">

                @if (User.Identity.IsAuthenticated)
                {
                    var player = (Player)SessionHelper.GetPlayerSessionData(Session, "player", User.Identity.GetUserId());

                    <li class="dropdown user user-menu">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            <span>Your Account</span>
                        </a>
                        <ul class="dropdown-menu">
                            @if (player != null)
                            {
                                <li class="user-header">
                                    <p>
                                        @if (player != null)
                                        {
                                            @player.DisplayName
                                        }

                                    </p>
                                    <small>Member since @player.CreatedDateTime </small>
                                </li>
                            }
                            <li class="user-footer">
                                <div class="pull-left">
                                    <a href="~/Account/UpdateAccount" class="btn btn-default btn-flat">Profile</a>
                                </div>
                                <div class="pull-right">

                                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-left" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-default btn-flat">Sign out</a>
                                    }
                                </div>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="user-footer">@Html.ActionLink("Register", "Register", "Account", null, new { id = "registerLink" })</li>
                    <li class="user-footer">@Html.ActionLink("Log in", "Login", "Account", null, new { id = "loginLink" })</li>
                }

            </ul>
        </div>

        <!-- Navbar Right Menu -->
        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">

                <!-- Notifications: style can be found in dropdown.less -->
                <li class="dropdown notifications-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <i class="fa fa-bell-o"></i>
                      @*  <span class="label label-warning">2</span>*@
                    </a>
                    <!--<ul class="dropdown-menu">
                        <li class="header">You have 2 notifications</li>
                        <li>-->
                            <!-- inner menu: contains the actual data -->
                            <!--<ul class="menu">
                                <li>
                                    <a href="#">
                                        <i class="fa fa-soccer-ball-o"></i> Premier League 21/22 Comps available
                                    </a>
                                </li>
                                <li>
                                    <a href="#">
                                        <i class="fa fa-soccer-ball-o"></i> Scottish Prem 21/22 Comps available
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>-->
                </li>
                <!-- Tasks: style can be found in dropdown.less -->
            </ul>
        </div>
    </nav>
</header>