@using Microsoft.Ajax.Utilities
@using Microsoft.AspNet.Identity
@model IEnumerable<Predict.Models.PoolPlayer>

@{
    ViewBag.Title = "Pool Membership";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="~/PoolDashboard">Pool Admin</a>
        </li>

        <li class="breadcrumb-item active" aria-current="page">Your Pools</li>
    </ol>
</nav>



<table class="table table-bordered table-hover" id="poolMembershipJoined">
    <thead>
        <tr>
            <th>
                Pool Name
            </th>
        </tr>
    </thead>

    @foreach (var joinedPool in @Model)
    {
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => joinedPool.Pool.PoolName)
                </td>
                <td>
                    @if(!joinedPool.Pool.DefaultPoolForEvent)
                    {
                        <button class="btn btn-danger js-delete btn-sm" value="Join" dataPlayerId="@joinedPool.PlayerId" dataPoolId="@joinedPool.Pool.Id" poolName="@joinedPool.Pool.PoolName">Leave Pool</button>
                    }
                    
                  
                </td>
                    
            </tr>
        }
    }
</table>


<script src="~/Scripts/bootbox.js"></script>

<script>

    $(function () {
        $("#poolMembershipJoined, #poolMembershipNotJoined").DataTable({
            "bLengthChange": false
        });;
    });


</script>

<script>


    $("#poolMembershipJoined").on("click",
        ".js-delete",
        function() {
            var button = $(this);
            bootbox.confirm("Are you sure you want to leave the " + button.attr("poolName") + " pool?",
                function(result) {
                    $.ajax(
                        {
                            url: "../api/poolPlayers/delete/" + button.attr("dataPoolId") + "/@(User.Identity.GetUserId())",
                            method: "POST",
                            success: function() {
                                $(button.closest("tr")).fadeOut(1000);
                            }
                        });


                });
        });



</script>