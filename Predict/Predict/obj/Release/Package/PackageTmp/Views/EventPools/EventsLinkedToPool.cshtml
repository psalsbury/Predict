@using Microsoft.AspNet.Identity
@using Predict.Models
@using System.Linq;
@using Microsoft.Ajax.Utilities
@model Predict.ViewModels.EventPoolsViewModel
@{
    ViewBag.Title = "Add Comps to " + ViewBag.PoolName;
    var playerId = User.Identity.GetUserId();
}

@using (Html.BeginForm("Save", "EventPools"))
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="~/PoolDashboard">League Admin</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Pools/">Manage Leagues</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Comps</li>
        </ol>
    </nav>

    @Html.HiddenFor(a => Model.PoolId)

    <table class="table" id="EventPools">
        <tr>
            <th>
                Comp Name
            </th>
            <th class="hidden-xs">
                Comp Start Date
            </th>
            <th>Linked</th>
            <th>&nbsp;</th>
        </tr>

        @foreach (var item in Model.Events.Where(a => a.StartDateTime >= DateTime.UtcNow.AddMonths(-1)).OrderByDescending(a => a.EndDateTime))
        {
            <tr>
                <td>
                    @if (item.EventDescription.IsNullOrWhiteSpace())
                    {
                        @Html.DisplayFor(modelItem => item.EventName)
                    }
                    else
                    {
                        @Html.DisplayFor(modelItem => item.EventDescription)
                    }
                </td>
                <td class="hidden-xs">
                    @Html.DisplayFor(a => item.StartDateTime)
                </td>
                <td>
                    @{ var exists = Model.EventPools.Exists(a => a.EventId == item.Id); }

                    @if (item.EventFinished && exists)
                    {
                        <text>Yes</text>
                    }
                    else if (item.EventFinished && !exists)
                    {
                        <text>No</text>
                    }
                    else
                    {
                        <input type="checkbox" value="@item.Id" id="event_@item.Id" name="event_@item.Id" @(exists ? "checked" : "") )>
                    }

                </td>
                <td>
                    @if (exists)
                    {
                        <a href="~/EventPools/EventPoolInvites?eventid=@item.Id&poolid=@Model.PoolId" class="btn btn-block btn-success"><i class="fa fa-envelope"></i>&nbsp;Invites</a>
                    }
                    else
                    {
                        <text>  &nbsp; </text>
                    }
                </td>
            </tr>
        }
    </table>

        <div class="form-group">
            @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
            <input type="submit" value="Save" class="btn btn-success" />
        </div>

    }
<br/>

