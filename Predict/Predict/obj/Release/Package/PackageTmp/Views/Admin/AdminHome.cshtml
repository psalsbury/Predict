@using Predict.RapidApi
@using (Html.BeginForm("SaveUpdateScoring", "Admin"))
{
    <div class="form-group">
        <div>
            @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
            <input type="submit" value="Update Scoring" class="btn btn-default" />
        </div>
    </div>
}

@using (Html.BeginForm("ForceDailyUpdate", "Admin"))
{
    <div class="form-group">
        <div>
            @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
            <input type="submit" value="Force Daily Update" class="btn btn-default" />
        </div>
    </div>
}

@using (Html.BeginForm("V3Leagues", "Admin"))
{
    <div class="form-group">
        <div>
            @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@

            @Html.Label("Country")
            @Html.TextBox("Country")
            @Html.Label("Year")
            @Html.TextBox("Year")

            <input type="submit" value="V3 Leagues" class="btn btn-default" />
        </div>
    </div>
}

<input type="button"
       value="All Fixtures"
       class="btn btn-default"
       onclick="location.href='@Url.Action("Index", "Fixtures") '" />

<input type="button"
       value="Leagues"
       class="btn btn-default"
       onclick="location.href = '@Url.Action("LeaguesIndex", "Leagues") '" />

<br />
<h2>RapidAPI Next Check Time (UTC Time)</h2>
<br />
<h3>Current UTC Time is </h3>
@DateTime.UtcNow
<br />
<br />
@{
    var rapidApiResultChecks = (List<RapidApiResultCheck>)Predict.Helper.Cache.GetCachedItem("NextFixtureCheckDateTime");
    foreach (var rapidApiResultCheck in rapidApiResultChecks)
    {
        @rapidApiResultCheck.RapidApiLeagueId;
        <text>-->(Last outstanding Fixture) </text>
        @rapidApiResultCheck.FixtureDateTime;
        <text>-->(Next time to check)</text>
        @rapidApiResultCheck.ResultCheckDateTime;
        <text>
            <br />
        </text>
    }
}



