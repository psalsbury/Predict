@model Predict.Models.Event
@{
    ViewBag.Title = "Admin Home";
}

<h1>
    @Model.EventName Admin
</h1>

<br/>

<a href="@Url.Action("Index", "Fixtures", new {eventId = Model.Id})">
    <span><h2>Edit Fixtures</h2></span>
</a>
<br/>
<a href="@Url.Action("Index", "KOFixtures", new {eventId = Model.Id})">
    <span><h2>Edit KO Fixtures</h2></span>
</a>
<br/>
<a href="@Url.Action("EditKoResults", "KoFixtures", new {eventId = Model.Id})">
    <span><h2>Enter KO Results</h2></span>
</a>
<br/>
<a href="@Url.Action("UpdateScoring", "Admin", new {eventId = Model.Id})">
    <span><h2>Update Scoring</h2></span>
</a>