@using Microsoft.AspNet.Identity
@using WebHelpers.Mvc5
<aside class="main-sidebar">
    <section class="sidebar">
       
        @* BEGIN Menu *@
        <ul class="sidebar-menu" data-widget="tree">
            <li class="header">Euro 2020 Menu</li>
            <li class="@Url.IsLinkActive("Index", "Home" )">
                <a href="@Url.Action("Index", "Home" )"><i class="fa fa-home"></i> <span>Home</span></a>
            </li>
            <li class="@Url.IsLinkActive("Rules", "Home" )">
                <a href="@Url.Action("Rules", "Home" )"><i class="fa fa-book"></i> <span>Help</span></a>
            </li>
            <li class="treeview">
                <a href="#">
                    <i class="fa fa-table"></i> <span>Tables</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu">
                    <li>@Html.ActionLink("Global Table", "Index", "Table")</li>
                    <li>@Html.ActionLink("Best Teams", "BestTeams", "Table")</li>
                    <li>@Html.ActionLink("Best Pools", "BestPools", "Table")</li>
                    <li>@Html.ActionLink("Teams Best", "Index", "Table", new { tableTypeId = 3 }, null)</li>
                    <li>@Html.ActionLink("Pools Best", "Index", "Table", new { tableTypeId = 2 }, null)</li>
                </ul>
            </li>

            @if (Request.IsAuthenticated)
            {
                <li class="@Url.IsLinkActive("Index", "Pools" )">
                    <a href="@Url.Action("PoolMembershipIndex", "Pools" )"><i class="fa fa-users"></i> <span>Pool Membership</span></a>
                </li>

                <li class="treeview">
                    <a href="#">
                        <i class="fa fa-edit"></i> <span>Predictions</span>
                        <span class="pull-right-container">
                            <i class="fa fa-angle-left pull-right"></i>
                        </span>
                    </a>
                    <ul class="treeview-menu">
                        <li>@Html.ActionLink("Edit Game Predictions", "FixturePredictions", "FixturePredictions")</li>
                        <li>@Html.ActionLink("Edit Knock Out Predictions", "KOFixturePredictionsGrouped", "KOFixturePredictions", new { readOnly = false }, null)</li>
                        <li>@Html.ActionLink("Edit Bonus Questions", "Edit", "BonusQuestionPredictions")</li>
                        <li>@Html.ActionLink("View Predictions", "ViewPredictions", "PredictionsConsolidated", new { playerid = User.Identity.GetUserId() }, null)</li>
                    </ul>
                </li>

                <li class="treeview">
                    <a href="#">
                        <i class="fa  fa-soccer-ball-o"></i> <span>Admin</span>
                        <span class="pull-right-container">
                            <i class="fa fa-angle-left pull-right"></i>
                        </span>
                    </a>
                    <ul class="treeview-menu">                        
                        <li>@Html.ActionLink("Pool Admin", "Index", "Pools")</li>

                        @if (User.IsInRole("Admin"))
                        {

                            <li>@Html.ActionLink("Fixtures", "Index", "Fixtures")</li>
                            <li>@Html.ActionLink("Ko Fixtures", "Index", "KOFixtures")</li>
                            <li>@Html.ActionLink("Enter KO Results", "EditKoResults", "KoFixtures")</li>
                            <li>@Html.ActionLink("Update Scoring", "UpdateScoring", "Admin")</li>
                        }
                    </ul>
                </li>
            }

            <li class="treeview">
                <a href="#">
                    <i class="fa fa-area-chart"></i> <span>Betting tips/Stats</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu">
                    <li>@Html.ActionLink("Group Games", "Index", "StatsGroup")</li>
                    <li>@Html.ActionLink("Knock Out Games", "Index", "StatsKO")</li>
                </ul>
            </li>

            <li class="treeview">
                <a href="#">
                    <i class="fa fa-trophy"></i> <span>Results</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu">
                    <li>@Html.ActionLink("Group Game Results", "GroupGameResults", "Results")</li>
                    <li>@Html.ActionLink("Knock Out Results", "KoResults", "Results")</li>
                </ul>
            </li>


        </ul>
        @* END Menu *@
    </section>
</aside>