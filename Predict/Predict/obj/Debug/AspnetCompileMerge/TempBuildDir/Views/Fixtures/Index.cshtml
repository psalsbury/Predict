@model IEnumerable<Predict.Models.Fixture>

@{
    ViewBag.Title = "Fixture List";
}

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table table-bordered table-hover" id="fixtures">
    <tr>
        <th></th>
        <th>
            @Html.DisplayNameFor(model => model.HomeTeam.TeamName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.HomeResult)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AwayResult)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AwayTeam.TeamName)
        </th>
        <th>

        </th>

        <th>
            @Html.DisplayNameFor(model => model.FixtureDateTime)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img src="@Url.Content(item.HomeTeam.FlagFileLocation)" height="20"/>
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.HomeTeam.TeamName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HomeResult)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AwayResult)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.AwayTeam.TeamName)
            </td>
            <td>
                <img src="@Url.Content(item.AwayTeam.FlagFileLocation)" height="20"/>
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.FixtureDateTime)
            </td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    @Html.ActionLink("Edit", "Edit", new {id = item.Id})
                }
            </td>
        </tr>
    }

</table>

<script>

    $(function() {
        $("#fixtures").DataTable({
            "bLengthChange": false
        });;
    });


</script>