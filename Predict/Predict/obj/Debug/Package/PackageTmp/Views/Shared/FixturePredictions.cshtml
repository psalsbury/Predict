@using System.Text.RegularExpressions
@using Predict.Models
@using System
@using Microsoft.AspNet.Identity
@model Predict.ViewModels.FixturePredictionsViewModel
@{
    ViewBag.Title = "Edit Group Game Predictions";
}
    @if (!Model.ReadOnly)
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="~/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Fixture Predictions</li>
            </ol>
        </nav>
    }


@if (!Model.ReadOnly)
{
    <input class="btn btn-primary" title="Click to select let the computer pick your predictions for you. You can click on 'Reset' to undo your changes if you don't like them!" type="button" value="Lucky Dip" onclick="javascript:LuckyDip()" id="LuckyD" name="LuckyD">
}
@using (Html.BeginForm("Save", "FixturePredictions"))
{
    <table id="predictions" name="precictions" class="table table-bordered table-hover">
        <thead>
            <tr>

                <th style="vertical-align: middle;text-align:center">

                </th>
                <th style="vertical-align: middle;text-align:center">Game</th>
                <th style="vertical-align: middle;text-align:center">
                    Fixture Date/Time
                </th>
            </tr>
        </thead>
        @for (int i = 0; i < Model.FixturePredictions.Count(); i++)
        {
            <tr>
                <td style="vertical-align: middle;text-align:center">
                    @Html.HiddenFor(m => m.FixturePredictions[i].FixtureId)
                    <b> @Model.EventTeams.Find(m => m.TeamId == @Model.FixturePredictions[i].Fixture.HomeTeam.Id && m.EventId == @Model.FixturePredictions[i].Fixture.EventId).League</b>
                </td>

                <td style="vertical-align: middle;text-align:center">
                    <div class="container-fluid">
                        <div class="row vertical-middle text-center">
                            <div class="col-sm-6 text-center">
                                <table width="100%" cellpadding="2">
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(@Model.FixturePredictions[i].Fixture.HomeTeam.FlagFileLocation)" height="20" />
                                        </td>
                                        <td style="text-align:left" width="60%">
                                            @Html.DisplayFor(m => m.FixturePredictions[i].Fixture.HomeTeam.TeamName)
                                        </td>
                                        <td style="text-align:left" width="20%" >
                                            @if (Model.ReadOnly || Model.FixturePredictions[i].Fixture.FixtureDatePassed)
                                            {
                                                @Html.DisplayFor(m => m.FixturePredictions[i].HomePrediction)
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(m => m.FixturePredictions[i].HomePrediction, new { onblur = "IsNumeric(this)", size = "2", maxlength = "2" })
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-sm-6 text-center">
                                <table width="100%" cellpadding="2">
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(@Model.FixturePredictions[i].Fixture.AwayTeam.FlagFileLocation)" height="20" />
                                        </td>
                                        <td style="text-align:left" width="60%">
                                            @Html.DisplayFor(m => m.FixturePredictions[i].Fixture.AwayTeam.TeamName)
                                        </td>
                                        <td style="text-align:left" width="20%">
                                            @if (Model.ReadOnly || Model.FixturePredictions[i].Fixture.FixtureDatePassed)
                                            {
                                                @Html.DisplayFor(m => m.FixturePredictions[i].AwayPrediction)
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(m => m.FixturePredictions[i].AwayPrediction, new { onblur = "IsNumeric(this)", size = "2", maxlength = "2" })
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </td>

                <td style="vertical-align: middle; text-align: center">
                    @Model.FixturePredictions[i].Fixture.FixtureDateTime.ToString("dd MMM") @@ @Model.FixturePredictions[i].Fixture.FixtureDateTime.ToShortTimeString()
                </td>
            </tr>
        }
    </table>


    @Html.AntiForgeryToken()

    if (!Model.ReadOnly)
    {
        <div class="form-group">
            <div>
                <input type="submit" value="Save" class="btn btn-success" />
                <input class="btn btn-danger" title="Click to clear all predictions" type="button" value="Clear" onclick="javascript:ClearPredictions()" id="Clear" name="Clear">
            </div>
        </div>
    }
}
<br />

<script src="../Scripts/bootbox.js"></script>
@if (!Model.ReadOnly)
{
    <script>

        function IsNumeric(obj) {
            //  check for valid numeric strings
            var strString = obj.value;
            var strValidChars = "0123456789";
            var strChar;
            var blnResult = true;
            if (strString.length == 0) return true; // Nulls are ok

            //  test strString consists of valid characters listed above
            for (i = 0; i < strString.length && blnResult == true; i++) {
                strChar = strString.charAt(i);
                if (strValidChars.indexOf(strChar) == -1) {
                    obj.select();
                    obj.focus();
                    alert('Please enter a numerical value');
                    obj.value = "";
                    blnResult = false;
                }
            }
            return blnResult;
        }

        function LuckyDip() {
            bootbox.confirm("Lucky dip, are you sure?", function (result) {


                @{
                var position = 0;
                foreach (var fixturePrediction in Model.FixturePredictions)
                {

                    var fixtureDateTime = fixturePrediction.Fixture.FixtureDateTime;
                    var now = DateTime.Now.ToUniversalTime();

                    var diffInSeconds = (fixtureDateTime - now).TotalSeconds;
                    if (diffInSeconds > 0)
                    {

                        <text>
                            $('#FixturePredictions_@(position)__HomePrediction')
                                .val(Math.round(Math.random() * 3));
                            $('#FixturePredictions_@(position)__AwayPrediction')
                                .val(Math.round(Math.random() * 3));
                        </text>
                    }
                    position = position + 1;
                }
            }
            });
        }

        function ClearPredictions() {
            bootbox.confirm("Clear your predictions, are you sure?", function (result) {

                @{
                position = 0;
                foreach (var fixturePrediction in Model.FixturePredictions)
                {

                    var fixtureDateTime = fixturePrediction.Fixture.FixtureDateTime;
                    var now = DateTime.Now.ToUniversalTime();

                    var diffInSeconds = (fixtureDateTime - now).TotalSeconds;
                    if (diffInSeconds > 0)
                    {

                        <text>
                            $('#FixturePredictions_@(position)__HomePrediction')
                                .val("");
                            $('#FixturePredictions_@(position)__AwayPrediction')
                                .val("");
                        </text>
                    }
                    position = position + 1;
                }
            }
            });
        }
    </script>
}

<script>
    function adjustForTimeZone(date) {
        var d = new Date();
        var minutes = d.getTimezoneOffset();
        return new Date(date.getTime() + minutes * 60000).toDateString();
    }
</script>

<script>
    $(function () {
        $("#predictions").DataTable({
            "bLengthChange": false
            , "iDisplayLength": 50
            , "bPaginate": false
            , "searching": false
            , "ordering": true
            , "autoWidth": false
            , "bInfo": false
            , columnDefs: [{
                targets: [0],
                orderData: [0, 2]
            }, {
                targets: [1],
                "orderable": false
            }, {
                targets: [2],
                orderData: [2, 2]
            }]
        });
    });
</script>

