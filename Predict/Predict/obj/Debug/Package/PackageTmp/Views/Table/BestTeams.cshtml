@using PagedList.Mvc
@using Predict.Models
@using Predict.ViewModels
@model PagedList.IPagedList<Predict.ViewModels.BestTeamsTableViewModel>


<style>
    table {
        border-collapse: collapse;
        width: 100%;
    }

    th, td {
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }
</style>

<h2> @ViewBag.TableName</h2>

<table class="table">
    <thead>
        <tr>
        <tr style="background-color:#428bca">
            <td style="background-color:#428bca ;text-align:center"><b><font color="white">Posn</font></b></td>
            <td><b><font color="white">Player Information</font></b></td>
            <td colspan="4" style="text-align:center"><b><font color="white">Points</font></b></td>
        </tr>
        <tr style="background-color:#428bca">
            <td>&nbsp</td>
            <td>&nbsp</td>
            <td STYLE="text-align:center;color:WHITE"><b>CS</b></td>
            <td STYLE="text-align:center;color:WHITE"><b>CR</b></td>
            <td STYLE="text-align:center;color:WHITE"><b>KO</b></td>
            <td STYLE="text-align:center;color:WHITE"><b>Total</b></td>
        </tr>
    </thead>

    @foreach (BestTeamsTableViewModel tableViewModel in Model)
    {
        <tr style="font-size:larger">
            <td style="text-align: center">
                @tableViewModel.PoolPosition.ToString()
            </td>
            <td>
                @tableViewModel.TeamName
            </td>
            <td STYLE="text-align:center">
                @tableViewModel.CorrectScore.ToString()
            </td>
            <td STYLE="text-align:center">
                @tableViewModel.CorrectResult.ToString()
            </td>
            <td STYLE="text-align:center">
                @tableViewModel.KoScore.ToString()
            </td>
            <td STYLE="text-align:center">
                @tableViewModel.TotalScore.ToString()
            </td>
        </tr>
    }

</table>
<br />
Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index",
    new { @ViewBag.PoolId, ViewBag.TableTypeId, page}))