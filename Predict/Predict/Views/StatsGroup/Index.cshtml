@model IEnumerable<Predict.Models.Fixture>

@{
    ViewBag.Title = "Group Games Stats";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="~/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Group Game Stats</li>
    </ol>
</nav>

<table class="table table-bordered table-hover" id="fixtures" name="fixtures" align="center">
    <tr>
        <th style="vertical-align: middle;text-align:center">
            Match
        </th>
        <th style="vertical-align: middle;text-align:center">
            Fixture Date/Time
        </th>
        <th>
            
        </th>
    </tr>

    @foreach (var item in Model)
    {

        <tr>

            <td style="vertical-align: middle;text-align:left">
                <div class="container-fluid">
                    <div class="row vertical-middle text-center">
                        <div class="col-sm-6 text-center">
                            <table width="100%">
                                <tr>
                                    <td width="20%">
                                        <img src="@Url.Content(item.HomeTeam.FlagFileLocation)" height="20" />
                                    </td>
                                    <td width="80%">
                                        @Html.DisplayFor(modelItem => item.HomeTeam.TeamName)
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="col-sm-6 text-center">
                            <table width="100%">
                                <tr>
                                    <td width="20%">
                                        <img src="@Url.Content(item.AwayTeam.FlagFileLocation)" height="20" />
                                    </td>
                                    <td width="80%">
                                        @Html.DisplayFor(modelItem => item.AwayTeam.TeamName)
                                    </td>
 
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

            </td>


            <td style="vertical-align: middle; text-align: center" class="myDate">
               
                @Html.Hidden("FixtureDateTime",item.FixtureDateTime.ToLongDateString() + " " + item.FixtureDateTime.ToShortTimeString())    
            </td>
            <td>
                <a href="StatsGroup/StatsFixture/@item.Id" class="btn btn-primary btn active" role="button" aria-pressed="true">View Stats</a>
            </td>

        </tr>
    }

</table>

<script>

    //get all td with actionclass in table
    $("tbody tr td.myDate").each(function() {       

        $hiddenValue = $(this).find("input[type=hidden]").val();

        var d = new Date($hiddenValue);

        this.innerHTML = convertUTCDateToLocalDate(d);
        
    });

    function convertUTCDateToLocalDate(date) {
        var newDate = new Date(date.getTime()+date.getTimezoneOffset()*60*1000);

        var offset = date.getTimezoneOffset() / 60;
        var hours = date.getHours();

        newDate.setHours(hours - offset);
        mo = new Intl.DateTimeFormat('en', { month: 'short' }).format(newDate);
        da = new Intl.DateTimeFormat('en', { day: '2-digit' }).format(newDate);

        return da + ' ' + mo + ' ' + newDate.getHours() + ':' + pad(newDate.getMinutes(),2);

    }
    function pad(n, width, z) {
        z = z || '0';
        n = n + '';
        return n.length >= width ? n : new Array(width - n.length + 1).join(z) + n;
    }


</script>
<script>

    $(function () {
        $("#fixtures").DataTable({
            "bLengthChange": false
        });;
    });

</script>
