@model Predict.ViewModels.RegisterViewModel

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<div class="login-logo">
    <b>Prediction</b>Comp
</div>
<div class="register-box">

    <div class="register-box-body">
        <div>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "RegisterForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(a => a.JoinCode);

                <h4>Register a New Account</h4>
                <div class="form-group has-feedback">
                    @Html.ValidationSummary("", new { @class = "text-danger" })
                </div>

                <div class="form-group has-feedback">
                    @Html.TextBoxFor(m => m.DisplayName, new { @class = "form-control", @placeholder = "Display name" })
                    <span class="glyphicon glyphicon-user form-control-feedback"></span>
                </div>

                <div class="form-group has-feedback">

                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Email", @type = "email" })
                    <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
                </div>

                <div class="form-group has-feedback">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Password" })
                    <span class="glyphicon glyphicon-lock form-control-feedback"></span>
                </div>

                <div class="form-group has-feedback">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Retype password" })
                    <span class="glyphicon glyphicon-log-in form-control-feedback"></span>
                </div>
                <br />
                <div class="form-group">
                    Select a <b>Prediction</b>Comp to join:
                    <select name="@Html.NameFor(m => m.EventId)" id="@Html.IdFor(m => m.EventId)" class="form-control">
                        @foreach (var item in Model.Events)
                        {
                            var selected = "";
                            if (Model.defaultEventId == item.Id)
                            {
                                selected = "selected";
                            }
                            <option value="@item.Id" @selected> @item.EventName </option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    Select a <b>League</b> to join:
                    <select name="@Html.NameFor(m => m.PoolId)" id="@Html.IdFor(m => m.PoolId)" class="form-control">
                        <option value="0"> None </option>
                        @foreach (var item in Model.Pools)
                        {
                            var selected = "";
                            if (Model.defaultPoolId == item.Id)
                            {
                                selected = "selected";
                            }
                            var joinCodeNeeded = item.JoinCode == null ? "" : "joinCodeNeeded";
                            <option @selected value="@item.Id" joinCode="@joinCodeNeeded" dataPoolId="@item.Id" poolName="@item.PoolName"> @item.PoolName </option>
                        }
                    </select>
                </div>

                <div class="form-group has-feedback">

                    <div class="g-recaptcha" style="transform: scale(0.77);
-webkit-transform: scale(0.77); transform-origin: 0 0;
-webkit-transform-origin: 0 0;" data-theme="light"
                         data-sitekey="6LdmK4IaAAAAAMb9yed_0Ap3tZQ-A1Df85qYSWez"></div>


                    <br />
                    <input type="submit" id="btnSubmit" class="btn btn-primary btn-block btn-flat" value="Register" />

                </div>
            }
        </div>
    </div>
</div>


<script>

    function onSubmit(token) {
        document.getElementById("RegisterForm").submit();
    }
</script>

<script>
    $(document).ready(function () {

        $("#RegisterForm").submit(function (e) {

            var poolName = $("#PoolId :selected").attr("poolName");
            var requiresCode = $("#PoolId :selected").attr("joinCode");
            var joinCode = "";
            if (requiresCode != "") {
                joinCode = prompt("Please enter the join code for " + poolName + " league");
                document.getElementById('JoinCode').value = joinCode;
            }
        });
    });
</script>


<script src="~/Scripts/bootbox.js"></script>
