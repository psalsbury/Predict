@model IEnumerable<Predict.Models.Pool>

@{
    ViewBag.Title = "Manage Your Pools";
    var globalPoolId = ViewBag.GlobalPoolId;
}
<link rel="stylesheet" href="~/content/css/ionicons.min.css">
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="~/PoolDashboard">Pool Admin</a>
        </li>

        <li class="breadcrumb-item active" aria-current="page">Manage Pools</li>
    </ol>
</nav>


<table id="poolsTable" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PoolName)
            </th>
            <th>
                &nbsp;
            </th>

        </tr>
    </thead>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PoolName)
            </td>
            <td>
                <a href="~/Pools/Edit/@item.Id" class="btn btn-info btn-sm">Edit</a>
                &nbsp;
                <a href="~/PoolPlayers/PoolAdmin/@item.Id" class="btn btn-primary btn-sm">Players</a>
                &nbsp;
                @if (item.Id != globalPoolId)
                {
                    <button class="btn btn-danger btn-sm" value="Remove" poolId="@item.Id">Delete</button>
                }

            </td>
        </tr>
    }

</table>
<script src="~/Scripts/bootbox.js"></script>
<script>
    $("#poolsTable").on("click",
        ".btn-danger",
        function () {

            var button = $(this);
            bootbox.confirm("Are you sure you want to delete this pool?",
                function (result) {
                    if (result) {
                        $.ajax(
                            {
                                url: "/api/pools/" + button.attr("poolId"),
                                method: "DELETE",
                                success: function () {
                                    $(button.closest("tr")).fadeOut(1000);
                                }
                            });
                    }
                });
        });
</script>


<script>

    $(function () {
        $("#poolsTable").DataTable({
            'columnDefs': [
                {
                    'targets': [2, 3, 4], /* column index */
                    'orderable': false, /* true or false */

                }
            ]
        });
    });

</script>