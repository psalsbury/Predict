@model Predict.Models.Pool

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">

        <li class="breadcrumb-item">
            <a href="/PoolDashboard/">Pool Admin</a>
        </li>
    @if (Model.Id == 0)
    {
        <li class="breadcrumb-item active" aria-current="page">New Pool</li>
    }
    else
    {
        <li class="breadcrumb-item">
            <a href="/Pools/">Manage Pools</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    }

    </ol>
</nav>

@if (Model.Id == 0)
{
    ViewBag.Title = "Create a new Pool";
}
else
{
    ViewBag.Title = "Edit " + Model.PoolName;
}

@using (Html.BeginForm("Save", "Pools"))
{
    @Html.ValidationSummary(true, "", new {@class = "text-danger"})
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.AdminPlayerId)
    @Html.HiddenFor(model => model.KoLast16Points)
    @Html.HiddenFor(model => model.KoLast8Points)
    @Html.HiddenFor(model => model.KoLast4Points)
    @Html.HiddenFor(model => model.KoLast2Points)
    @Html.HiddenFor(model => model.KoLast1Points)
    @Html.HiddenFor(model => model.InitialInfo)
    @Html.HiddenFor(model => model.FreezePredictions)

    <div class="box box-solid">

        <div class="box-header with-border">
            <h3 class="box-title">Pool Details</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
        </div>

        <div class="box-body">

            <div class="form-group">
                @Html.LabelFor(model => model.PoolName, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.PoolName, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(model => model.PoolName, "", new {@class = "text-danger"})
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.JoinCode, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.JoinCode, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(model => model.JoinCode, "", new {@class = "text-danger"})
                    <p>
                        <i>Players will need to enter this code to join your pool. Leave blank for no code needed</i>
                    </p>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.MemberInfo, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.MemberInfo, new {@class = "form-control", rows = 5})
                    @Html.ValidationMessageFor(model => model.MemberInfo, "", new {@class = "text-danger"})
                    <p>
                        <i>This will be displayed to each player in your pool on their home page</i>
                    </p>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.EmailNotifications, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    <div class="checkbox">
                        @Html.EditorFor(model => model.EmailNotifications)
                        @Html.ValidationMessageFor(model => model.EmailNotifications, "", new {@class = "text-danger"})
                        <p>
                            <i>Ticking will ensure you receive an email when a player joins your pool</i>
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="box box-solid collapsed-box">
        <div class="box-header with-border">
            <h3 class="box-title">Entry Fee</h3>

            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-plus"></i>
                </button>
            </div>

        </div>
        <!-- /.box-header -->
        <div class="box-body">

            <div class="form-group">
                @Html.LabelFor(model => model.EntryFee, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.CheckBox("EntryFeeRequired", Model.EntryFee == null ? false : true)
                    <p>
                        <i>The pool admin will be responsible for collecting and distributing the winnings </i>
                    </p>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.EntryFee, new {@class = "control-label col-md-2 width:co"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.EntryFee, new {htmlAttributes = new {@class = "form-control"}})
                </div>
                @Html.ValidationMessageFor(model => model.EntryFee, "", new {@class = "text-danger"})
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.FirstPercent, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.FirstPercent, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(model => model.FirstPercent, "", new {@class = "text-danger"})
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.SecondPercent, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.SecondPercent, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(model => model.SecondPercent, "", new {@class = "text-danger"})
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.ThirdPercent, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.ThirdPercent, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(model => model.ThirdPercent, "", new {@class = "text-danger"})
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.NonPrizePercent, new {@class = "control-label col-md-2"})
                <div class="col-md-10">
                    @Html.EditorFor(model => model.NonPrizePercent, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(model => model.NonPrizePercent, "", new {@class = "text-danger"})
                </div>
            </div>
        </div>
    </div>

    <div class="box box-solid collapsed-box">
        <div class="box-header with-border">
            <h3 class="box-title">Scoring</h3>
            <div class="box-tools pull-right">
                <button id="pete" type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-plus"></i>
                </button>
            </div>

        </div>
        <!-- /.box-header -->
        <div class="box-body">

            <div id="ScoringTab" class="tabcontent">
                <div class="form-group">
                    @Html.LabelFor(model => model.CorrectScorePoints, new {@class = "control-label col-md-2"})
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.CorrectScorePoints, new {htmlAttributes = new {@class = "form-control"}})
                        @Html.ValidationMessageFor(model => model.CorrectScorePoints, "", new {@class = "text-danger"})
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.CorrectResultPoints, new {@class = "control-label col-md-2"})
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.CorrectResultPoints, new {htmlAttributes = new {@class = "form-control"}})
                        @Html.ValidationMessageFor(model => model.CorrectResultPoints, "", new {@class = "text-danger"})
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.WinMarginPoints, new {@class = "control-label col-md-2"})
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WinMarginPoints, new {htmlAttributes = new {@class = "form-control"}})
                        @Html.ValidationMessageFor(model => model.WinMarginPoints, "", new {@class = "text-danger"})
                    </div>
                </div>
            </div>


        </div>
    </div>

    <br/>

    <div class="form-group">
        @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
        <input type="submit" value="Save" class="btn btn-success" onclick="return ValidateForm()"/>
    </div>
}

<script>

    $('#EntryFeeRequired').on('ifChanged',
        function(event) {

            var st = this.checked;

            $("#EntryFee").attr('disabled', !st);
            $("#FirstPercent").attr('disabled', !st);
            $("#SecondPercent").attr('disabled', !st);
            $("#ThirdPercent").attr('disabled', !st);
            $("#NonPrizePercent").attr('disabled', !st);

            if (!st) {
                $("#EntryFee").val("");
                $("#FirstPercent").val("");
                $("#SecondPercent").val("");
                $("#ThirdPercent").val("");
                $("#NonPrizePercent").val("");
            };
        });


    @if (Model.EntryFee == null)
    {
        <text>
    $("#EntryFee").attr('disabled', true);
    $("#FirstPercent").attr('disabled', true);
    $("#SecondPercent").attr('disabled', true);
    $("#ThirdPercent").attr('disabled', true);
    $("#NonPrizePercent").attr('disabled', true);

        </text>
    }


</script>
<script>

    function ValidateForm() {

        var totperc;
        if (document.getElementById("EntryFeeRequired").checked === true) {
            if ((document.getElementById("EntryFeeRequired").value) * 1 <= 0) {
                alert("Entry fee ust be greater than 0");
                return false;
            }
            totperc = (document.getElementById("FirstPercent").value) * 1 +
                (document.getElementById("SecondPercent").value) * 1 +
                (document.getElementById("ThirdPercent").value) * 1 +
                (document.getElementById("NonPrizePercent").value) * 1;

            if (totperc != 100) {
                alert("Total percent of pot equals " + totperc + "%. The total percent must equal 100%");
                return false;
            }
        }
        return true;
    }

</script>