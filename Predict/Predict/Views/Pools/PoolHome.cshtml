@model Predict.ViewModels.PoolHomeViewModel
@{

    ViewBag.Title = Model.Pool.PoolName;
}

<div class="box box-success">

    <div class="box-header with-border">
        <h3 class="box-title">League Details</h3>
        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
        </div>
    </div>

    <div class="box-body">

        <div class="form-group">
            @Html.Label("Admin Name", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Pool.AdminPlayer.DisplayName, new { htmlAttributes = new { @readonly = "READONLY" } })
            </div>
        </div>
        <br />
        <div class="form-group">
            @Html.LabelFor(model => model.Pool.JoinCode, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Pool.JoinCode, new { htmlAttributes = new { @readonly = "READONLY" } })
            </div>
        </div>
        <br />
        <div class="form-group">
            @Html.LabelFor(model => model.Pool.MemberInfo, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Pool.MemberInfo, new { @class = "form-control", rows = 5, @readonly = "READONLY" })

            </div>
        </div>
        <br />
        <div class="form-group">
            @Html.LabelFor(model => model.Pool.FreezePredictions, new { @class = "control-label col-md-2" })
            <div class="col-md-10">



                @if (Model.Pool.FreezePredictions == true)
                {
                    <p>
                        <b>Yes</b> - Your predictions will be frozen after the first fixture
                    </p>
                }
                else
                {
                    <p>
                        <b>No</b> - Your game predictions can be changed up until kick off time
                    </p>
                }

            </div>
        </div>

    </div>
</div>

<div class="box box-success collapsed-box">
    <div class="box-header with-border">
        <h3 class="box-title">Scoring</h3>
        <div class="box-tools pull-right">
            <button id="pete" type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-plus"></i>
            </button>
        </div>

    </div>
    <!-- /.box-header -->
    <div class="box-body">

        <div id="ScoringTab" class="tabcontent">
            <div class="form-group">
                @Html.LabelFor(model => model.Pool.CorrectScorePoints, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Pool.CorrectScorePoints, new { htmlAttributes = new { @readonly = "READONLY" } })
                </div>
            </div>
            <br />
            <div class="form-group">
                @Html.LabelFor(model => model.Pool.CorrectResultPoints, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Pool.CorrectResultPoints, new { htmlAttributes = new { @readonly = "READONLY" } })
                </div>
            </div>
            <br />
            <div class="form-group">
                @Html.LabelFor(model => model.Pool.WinMarginPoints, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Pool.WinMarginPoints, new { htmlAttributes = new { @readonly = "READONLY" } })

                </div>
            </div>
        </div>


    </div>
</div>


<div class="box box-success">
    <div class="box-header with-border">
        <h3 class="box-title">Previous Winners</h3>
        <div class="box-tools pull-right">
            <button id="pete" type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>
        </div>

    </div>
    <div class="box-body">

        <div id="ScoringTab" class="tabcontent">
            <div class="box-body">

                @if (Model.EventPoolPlayers != null & Model.EventPoolPlayers.Count > 0)
                {

                    <table class="table table-bordered table-hover" id="fixturesByResult" style="width: 100%" align="center">
                        <tr>
                            <th>
                                Comp Name
                            </th>
                            <th>
                                Winner
                            </th>
                            <th>
                                Points
                            </th>
                        </tr>


                        @foreach (var eventPoolPlayer in Model.EventPoolPlayers)
                        {
                            <tr>
                                <td>
                                    <small>@eventPoolPlayer.Event.EventName</small>
                                </td>
                                <td>
                                    <small>@eventPoolPlayer.Player.PlayerName</small>
                                </td>
                                <td>
                                    <small>@eventPoolPlayer.TotalScore</small>
                                </td>
                            </tr>
                        }
                    </table>
                }
                else
                {
                    <text>No Previous Comps</text>
                }
            </div>
        </div>
    </div>
</div>

<div class="box box-primary direct-chat direct-chat-primary">
    <div class="box-header with-border">
        <h3 class="box-title">@Model.Pool.PoolName Chat</h3>
        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                <i class="fa fa-minus"></i>
            </button>

            <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
        </div>
    </div>
    <div class="box-body">

        <div class="direct-chat-messages" id="messages">


            @foreach (var poolchat in Model.PoolChats)
            {
                var rightLeft = "left";
                if (poolchat.PlayerId == Model.PoolPlayer.PlayerId)
                {
                    rightLeft = "right";
                }

                <div class="direct-chat-msg @rightLeft">
                    <div class="direct-chat-info clearfix">
                        <span class="direct-chat-name pull-@rightLeft">@poolchat.Player.DisplayName&nbsp;</span>
                        <span class="direct-chat-timestamp pull-@rightLeft">@poolchat.CreatedDateTime.ToString("dd MMM yy H:mm:ss") &nbsp;</span>
                    </div>

                    <img class="direct-chat-img" src="../images/person.png" alt="Message User Image">
                    <div class="direct-chat-text">
                        @poolchat.Message
                    </div>
                </div>
            }
        </div>


    </div>

    <div class="box-footer">
        <div class="input-group">
            <input type="text" maxlength="100" id="message" name="message" placeholder="Type Message ..." class="form-control">
            <span class="input-group-btn">
                <button class="btn btn-primary btn-flat" id="SendMessage">Send</button>
            </span>
        </div>
    </div>

</div>


<script>

    $("#messages").animate({ scrollTop: $('#messages').prop("scrollHeight") }, 1000);

    $(document).ready(function () {
        $("#SendMessage").on("click", function () {

            var newChat = new Object();
            newChat.poolId = '@Model.Pool.Id';
            newChat.message = $('#message').val();
            var ajaxRequest = {
                url: '../api/poolChats/AddPoolChat',
                type: 'POST',
                datatype: 'json',
                data: newChat,
                success: function () {
                    addChat($('#message').val());
                    newChat.message = $('#message').val('');
                }
            };

            $.ajax(ajaxRequest);

        });
    });

    function addChat(message) {

        var me = '<div class="direct-chat-msg right">'+
            '<div class="direct-chat-info clearfix">' +
            '<span class="direct-chat-name pull-right">@Model.PoolPlayer.Player.DisplayName</span>' +
            '<span class="direct-chat-timestamp pull-left">@DateTime.UtcNow.ToString("dd MMM yy H:mm:ss")</span>'+
            ' </div>' +
            '<img class="direct-chat-img" src="../images/person.png" alt="Message User Image">' +
            '<div class="direct-chat-text">' +
            message+
            '</div>' +
            '</div>'
        document.getElementById("messages").innerHTML = document.getElementById("messages").innerHTML + me;
        $("#messages").animate({ scrollTop: $('#messages').prop("scrollHeight") }, 1000);
    }


    $(document).ready(function () {
        function poll() {
            $.get({
                url: '/api/stream/',
                success: function (data) {
                    console.log(data)
                },
                timeout: 10000                    // == 10 seconds timeout
            }).always(function () {
                setTimeout(poll, 30000)           // == 30 seconds polling period
            })
        }

        // start polling
        poll()
    })

</script>