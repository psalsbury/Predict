@using Microsoft.AspNet.Identity
@using Predict.Models
@using System.Linq;
@model List<Predict.ViewModels.EventPlayersViewModel>

@{
    ViewBag.Title = "Finished Comps";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/CompsDashboard/CompsDashboardIndex">Comps Dashboard</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Finished Comps</li>
    </ol>
</nav>

<input class="form-control" id="myInput" type="text" placeholder="Search..">

<table id="EventPlayers" class="table table-hover">
    <tr>

        <th>
            Comp
        </th>
        <th>Players</th>
        <th>&nbsp;</th>
    </tr>

    @foreach (var item in Model)
    {

        <tr height="60">

            <td style="vertical-align: middle;">
                <h4>@Html.DisplayFor(modelItem => item.EventName)</h4>
            </td>
            <td style="vertical-align: middle;"><h4>@item.NbrPlayers</h4></td>
            <td style="vertical-align: middle;">

                <a class="btn btn-info" href='@Url.Action("Index", "Home", new { eventId = item.EventId})'>
                    <i class="fa fa-home"></i>
                </a>
            </td>
        </tr>
    }
</table>


<script>

    $(document).ready(function () {
        $("#myInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#EventPlayers tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });

</script>