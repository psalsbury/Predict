@using Microsoft.AspNet.Identity
@using Predict.Models
@using System.Linq;
@model List<Predict.ViewModels.EventPlayersViewModel>

@{
    var eventPlayers = (List<EventPlayer>)Session["EventPlayers"];
    var playerId = User.Identity.GetUserId();
    ViewBag.Title = "Join A Prediction Comp";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/CompsDashboard/CompsDashboardIndex">Comps Dashboard</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Join A Comp</li>
    </ol>
</nav>

<table id="EventPlayers" class="table table-hover">
    <tr>

        <th>
            Comp
        </th>
        <th>Players</th>
        <th>&nbsp;</th>
    </tr>

    @foreach (var item in Model)
    {

<tr height="60">

    <td style="vertical-align: middle;" >
        <h4>@Html.DisplayFor(modelItem => item.EventName)</h4>
    </td>
    <td style="vertical-align: middle;"><h4>@item.NbrPlayers</h4></td>
    <td style="vertical-align: middle;" class="row no-gutters">
        <button class="btn btn-success js-add btn-sm" value="Join" dataEventName="@item.EventName" dataEventId="@item.EventId">Join</button>
    </td>
</tr>
    }
</table>

<script src="~/Scripts/bootbox.js"></script>

<script>
    $("#EventPlayers").on("click",
        ".js-add",
        function () {
            var button = $(this);
            $(button.html("<i class='fa fa-refresh fa-spin'></i>"));
            $.ajax(
                {
                    url: "../api/EventPlayers/join/" + button.attr("dataEventId"),
                    method: "POST",
                    success: function () {

                        $.ajax({
                            type: "POST",
                            url: "/webservices/wsEventPlayer.asmx/UpdateEventPlayerSession",
                            data: "{}",
                            contentType: "application/json",
                            datatype: "json",
                            success: function () {
                                bootbox.alert("You have succesfully joined the " + button.attr("dataEventName") + " comp");
                                $('#sidebardiv').load('@Url.Action("_SideBar","Home")');
                            },
                            error: function (request, error) {
                                alert('Please log out and back in to refresh');
                            }
                        });

                        $(button.closest("tr")).fadeOut(1000);
                    },
                    error: function (request, error) {
                        bootbox.alert("Your request to join the " + button.attr("dataEventName") + " comp has failed");
                        $(button.attr('class', 'btn btn-success js-add btn-sm'));
                        $(button.html("Join"));
                    }
                });



        });
</script>