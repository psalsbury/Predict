@using Microsoft.AspNet.Identity
@using Predict.Models
@using System.Linq;
@model IEnumerable<Predict.Models.Event>

@{
    var eventPlayers = (List<EventPlayer>)Session["Events"];
    var playerId = User.Identity.GetUserId();
}
@using (Html.BeginForm("Save", "EventPlayers"))

{
    <table class="table" id="EventPlayers">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventName)
            </th>
            <th>Playing</th>
            <th>Home</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EventName)
                </td>
                <td>
                    @{ var exists = eventPlayers.Exists(a => a.EventId == item.Id); }
                    <input type="checkbox" value ="@item.Id" id="event_@item.Id" name="event_@item.Id" @(exists ? "checked" : "")>
                </td>
                <td>
                    @if (exists)
                    { 
                     <input  class="btn btn-primary" value="Home" title="Visit Home Page" type="button" onclick="javascript:window.location='/?eventid=@item.Id'">
                    }
                </td>
            </tr>
        }
    </table>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
            <input type="submit" value="Save" class="btn btn-default"/>
        </div>
    </div>

}

