@using Predict.Models
@{
    var nbrFixturePredictionsToEnter = 36;
    var nbrKoPredictionsToEnter = 31;
    var nbrBonusQuestionsToEnter = 2;

    var nbrFixturePredictionsEntered = (int) Session["nbrFixturePredictions"];
    var nbrKoPredictionsEntered = (int)Session["nbrKoPredictions"] + (int)Session["nbrWinningTeamPredictions"];
    var nbrBonusQuestionPredictionsEntered = (int) Session["nbrBonusQuestionPredictions"];

    var bonusPredictionBox = "green";
    if (nbrBonusQuestionPredictionsEntered == 0)
    {
        bonusPredictionBox = "red";
    }
    else if (nbrBonusQuestionsToEnter > nbrBonusQuestionPredictionsEntered)
    {
        bonusPredictionBox = "yellow";
    }

    var fixturePredictionBox = "green";
    if (nbrFixturePredictionsEntered == 0)
    {
        fixturePredictionBox = "red";
    }
    else if (nbrFixturePredictionsToEnter > nbrFixturePredictionsEntered)
    {
        fixturePredictionBox = "yellow";
    }

    var koPredictionBox = "green";
    if (nbrKoPredictionsEntered == 0)
    {
        koPredictionBox = "red";
    }
    else if (nbrKoPredictionsToEnter > nbrKoPredictionsEntered)
    {
        koPredictionBox = "yellow";
    }

}
<link rel="stylesheet" href="~/Content/css/ionicons.min.css">

<div class="row">
    <div class="col-lg-3 col-xs-6">
        <!-- small box -->
        <div class="small-box bg-@fixturePredictionBox">
            <div class="inner">
                <h3>@nbrFixturePredictionsEntered <sup style="font-size: 20px"> out of @nbrFixturePredictionsToEnter</sup></h3>
                <p>Group games predicted</p>
            </div>
            <div class="icon">
                <i class="ion ion-stats-bars"></i>
            </div>
            <a href="~/FixturePredictions/FixturePredictions" class="small-box-footer">
                Enter them here <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>


    <div class="col-lg-3 col-xs-6">
        <!-- small box -->
        <div class="small-box bg-@koPredictionBox">
            <div class="inner">
                <h3>@nbrKoPredictionsEntered <sup style="font-size: 20px"> out of @nbrKoPredictionsToEnter</sup></h3>
                <p>Knock Out Predictions entered</p>
            </div>
            <div class="icon">
                <i class="ion ion-stats-bars"></i>
            </div>
            <a href="~/KOFixturePredictions/KOFixturePredictionsGrouped?ReadOnly=false" class="small-box-footer">
                Enter them here <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>



    <div class="col-lg-3 col-xs-6">
        <!-- small box -->
        <div class="small-box bg-@bonusPredictionBox">
            <div class="inner">
                <h3>@nbrBonusQuestionPredictionsEntered <sup style="font-size: 20px"> out of @nbrBonusQuestionsToEnter</sup></h3>
                <p>Bonus Predictions entered</p>
            </div>
            <div class="icon">
                <i class="ion ion-stats-bars"></i>
            </div>
            <a href="~/BonusQuestionPredictions/Edit" class="small-box-footer">
                Enter them here <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

</div>

<div class="col-md-6">
    <!-- LINE CHART -->
    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title">Global League Position</h3>

            <div class="box-tools">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
            </div>
        </div>
        <div class="box-body chart-responsive">
            <div class="chart" id="line-chart" style="height: 300px;"></div>
        </div>
        <!-- /.box-body -->
    </div>

</div>


<script src="~/plugins/morris/morris.min.js"></script>
<script src="~/plugins/morris/raphael.min.js"></script>

@{
    var posnHistory = (List<PoolPlayerPositionHistory>) Session["posnHistory"] ;
}

<script>
    $(function () {

        // LINE CHART
        var line = new Morris.Line({
            element: 'line-chart',
            resize: true,
            data: [
                { y: '2011 Q1', item1: 2666 },
                { y: '2011 Q2', item1: 2778 },
                { y: '2011 Q3', item1: 4912 },
                { y: '2011 Q4', item1: 3767 },
                { y: '2012 Q1', item1: 6810 },
                { y: '2012 Q2', item1: 5670 },
                { y: '2012 Q3', item1: 4820 },
                { y: '2012 Q4', item1: 15073 },
                { y: '2013 Q1', item1: 10687 },
                { y: '2013 Q2', item1: 8432 }
            ],
            xkey: 'y',
            ykeys: ['item1'],
            labels: ['Item 1'],
            lineColors: ['#3c8dbc'],
            hideHover: 'auto'
        });


    });
</script>

