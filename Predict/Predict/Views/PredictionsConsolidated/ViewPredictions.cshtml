@using Microsoft.AspNet.Identity
@model Predict.ViewModels.PredictionsConsolidatedViewModel

@{
    ViewBag.Title = Model.Player.DisplayName + "'s Predictions";
    var showKOpPreds = DateTime.UtcNow > System.Convert.ToDateTime("20 Nov 2022 16:00") ? true : false;
    var showKBonusPreds1 = DateTime.UtcNow > System.Convert.ToDateTime("13 Dec 2022 19:00") ? true : false;
    var showKBonusPreds2 = DateTime.UtcNow > System.Convert.ToDateTime("18 Dec 2022 19:00") ? true : false;
    var fromSummary = ViewBag.Summary;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Home/Index?eventid=@Model.EventId">Home</a>
        </li>
        @if (fromSummary=="false")
         { 
            <li class="breadcrumb-item">
                <a href="/Table/ShowTable?eventid=@Model.EventId&poolid=@Model.PoolId">Table</a>
            </li>
         }
        <li class="breadcrumb-item active" aria-current="page">Predictions</li>
    </ol>
</nav>

@if (Model.BonusQuestionPredictionsViewModel == null && Model.KoFixturePredictionViewModel == null)
{
    @Html.Partial("FixturePredictions", Model.FixturePredictionsViewModel)
}
else
{
    <div class="nav-tabs-custom" width="100%">
        <ul class="nav nav-tabs">
            <li class="active">
                <a href="#tab_1" data-toggle="tab">Group</a>
            </li>

            @if (Model.KoFixturePredictionViewModel != null)
            {
                <li>
                    <a href="#tab_2" data-toggle="tab">KO</a>
                </li>
            }
            @if (Model.BonusQuestionPredictionsViewModel != null)
            {
                <li>
                    <a href="#tab_3" data-toggle="tab">Bonus</a>
                </li>
            }
            @if (Model.KoFixturePredictionViewModel != null)
            {
                <li>
                    <a href="#tab_4" data-toggle="tab">Grp Tables</a>
                </li>
            }
        </ul>
    </div>

    <div class="tab-content">
        <div class="tab-pane active" id="tab_1">

            @Html.Partial("FixturePredictions", Model.FixturePredictionsViewModel)
        </div>

        @if (Model.KoFixturePredictionViewModel != null)
        {
            <!-- /.tab-pane -->
            <div class="tab-pane" id="tab_2">
                
                @if (showKOpPreds | Model.PlayerId == User.Identity.GetUserId())
                {
                    @Html.Partial("KoFixturePredictions", Model.KoFixturePredictionViewModel)
                }
                else
                {
                    <h2>Predictions will be shown after the group matches have completed</h2>
                }

            </div>
        }

        @if (Model.BonusQuestionPredictionsViewModel != null)
        {
            <div class="tab-pane" id="tab_3">
                
                @if (showKBonusPreds1 | showKBonusPreds2| Model.PlayerId == User.Identity.GetUserId())
                {
                    @Html.Partial("BonusQuestionPredictions", Model.BonusQuestionPredictionsViewModel)
                }
                else
                {
                    <h2>Predictions will be shown after the final has started</h2>
                }
            </div>
        }

        @if (Model.KoFixturePredictionViewModel != null)
        {
            <div class="tab-pane" id="tab_4">
                
                @if (showKOpPreds | Model.PlayerId == User.Identity.GetUserId())
                {
                    @Html.Partial("LeagueTables", Model.LeagueTablesViewModel)
                }
                else
                {
                    <h2>Predictions will be shown after the group matches have completed</h2>
                }
            </div>
        }

    </div>
}