@using Predict.Models
@model Predict.ViewModels.GroupGameResultsViewModel

@{
    ViewBag.Title = "Fixture Results";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="~/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Group Results</li>
    </ol>
</nav>
<div>

    <table id="groupresults" name="groupresults" class="table table-bordered table-hover">
        <thead>
            <tr>

                <th class="hidden-xs" style="vertical-align: middle;text-align:center"></th>
                <th style="vertical-align: middle;text-align:center">Game</th>
                <th style="vertical-align: middle;text-align:center">
                    Fixture Date/Time
                </th>
            </tr>
        </thead>
        @for (int i = 0; i < Model.Fixtures.Count(); i++)
        {
            <tr>
                <td  class="hidden-xs" style="vertical-align: middle;text-align:center" witdth="25%">
                    <b> @Model.EventTeams.Find(m => m.TeamId == @Model.Fixtures[i].HomeTeam.Id && m.EventId == @Model.Fixtures[i].EventId).League</b>
                </td>

                <td style="vertical-align: middle;text-align:center" witdth="50%">
                    <div class="container-fluid">
                        <div class="row vertical-middle text-center">
                            <div class="col-sm-6 text-center">
                                <table width="100%" cellpadding="2">
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(@Model.Fixtures[i].HomeTeam.FlagFileLocation)" height="20" />
                                        </td>
                                        <td style="text-align:left" width="60%">
                                            &nbsp
                                            @Html.DisplayFor(m => m.Fixtures[i].HomeTeam.TeamName)
                                        </td>
                                        <td style="text-align: left" width="20%">
                                            @Html.DisplayFor(m => m.Fixtures[i].HomeResult, new { @class = "control-label col-md-2" })
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-sm-6 text-center">
                                <table width="100%" cellpadding="2">
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(@Model.Fixtures[i].AwayTeam.FlagFileLocation)" height="20" />
                                        </td>
                                        <td style="text-align:left" width="60%">
                                            &nbsp
                                            @Html.DisplayFor(m => m.Fixtures[i].AwayTeam.TeamName)
                                        </td>
                                        <td style="text-align: left" width="20%">
                                            @Html.DisplayFor(m => m.Fixtures[i].AwayResult, new { @class = "control-label col-md-2" })
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </td>
                
                <td style="vertical-align: middle; text-align: center" witdth="25%" class="myDate">
                    @Html.Hidden("FixtureDateTime", Model.Fixtures[i].FixtureDateTime.ToLongDateString() + " " + Model.Fixtures[i].FixtureDateTime.ToShortTimeString())

                </td>

            </tr>

        }
    </table>

</div>
<script>

    $(function () {
        $("#fixtures").DataTable({
            "bLengthChange": false,
            "autoWidth": false
        });;
    });

</script>


<script>

    //get all td with actionclass in table
    $("tbody tr td.myDate").each(function () {

        $hiddenValue = $(this).find("input[type=hidden]").val();

        var d = new Date($hiddenValue);

        this.innerHTML = convertUTCDateToLocalDate(d);

    });

    function convertUTCDateToLocalDate(date) {
        var newDate = new Date(date.getTime() + date.getTimezoneOffset() * 60 * 1000);

        var offset = date.getTimezoneOffset() / 60;
        var hours = date.getHours();

        newDate.setHours(hours - offset);
        mo = new Intl.DateTimeFormat('en', { month: 'short' }).format(newDate);
        da = new Intl.DateTimeFormat('en', { day: '2-digit' }).format(newDate);

        return da + ' ' + mo + ' ' + newDate.getHours() + ':' + pad(newDate.getMinutes(), 2);

    }
    function pad(n, width, z) {
        z = z || '0';
        n = n + '';
        return n.length >= width ? n : new Array(width - n.length + 1).join(z) + n;
    }

</script>