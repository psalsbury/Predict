@using Predict.Models
@model Predict.ViewModels.GroupGameResultsViewModel

@{
    ViewBag.Title = "Group Game Results";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="~/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Group Results</li>
    </ol>
</nav>
<div>

    <table id="groupresults" name="groupresults" class="table table-bordered table-hover">
        <thead>
            <tr>

                <th style="vertical-align: middle;text-align:center">

                </th>
                <th style="vertical-align: middle;text-align:center">Game</th>
                <th style="vertical-align: middle;text-align:center">
                    Fixture Date/Time
                </th>
            </tr>
        </thead>
        @for (int i = 0; i < Model.Fixtures.Count(); i++)
        {
            <tr>
                <td style="vertical-align: middle;text-align:center">
                    @Html.HiddenFor(m => m.Fixtures[i].Id)

                    <b> @Model.EventTeams.Find(m => m.TeamId == @Model.Fixtures[i].HomeTeam.Id && m.EventId == @Model.Fixtures[i].EventId).League</b>
                </td>

                <td style="vertical-align: middle;text-align:left">
                    <div class="container-fluid">
                        <div class="row vertical-middle text-center">
                            <div class="col-sm-6 text-center">
                                <table>
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(@Model.Fixtures[i].HomeTeam.FlagFileLocation)" />
                                        </td>
                                        <td width="60%" style="text-align: left">
                                            @Html.DisplayFor(m => m.Fixtures[i].HomeTeam.TeamName)
                                        </td>
                                        <td width="20%">
                                            @Html.DisplayFor(m => m.Fixtures[i].HomeResult)
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-sm-6 text-center">
                                <table>
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(@Model.Fixtures[i].AwayTeam.FlagFileLocation)" />
                                        </td>
                                        <td width="60%" style="text-align: left">
                                            @Html.DisplayFor(m => m.Fixtures[i].AwayTeam.TeamName)
                                        </td>
                                        <td width="20%">
                                            @Html.DisplayFor(m => m.Fixtures[i].AwayResult)
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </td>

                <td style="vertical-align: middle; text-align: center">
                    @Model.Fixtures[i].FixtureDateTime.ToString("dd MMM") @@ @Model.Fixtures[i].FixtureDateTime.ToShortTimeString()
                </td>
            </tr>
        }
    </table>

</div>
<script>

    $(function () {
        $("#fixtures").DataTable({
            "bLengthChange": false,
            "autoWidth": false
        });;
    });

</script>


<script>
    $(function () {
        $("#groupresults").DataTable({
            "bLengthChange": false
            , "iDisplayLength": 50
            , "bPaginate": false
            , "searching": false
            , "ordering": true
            , "autoWidth": false
            , "bInfo": false
            , columnDefs: [{
                targets: [0],
                orderData: [0, 2]
            }, {
                targets: [1],
                "orderable": false
            }, {
                targets: [2],
                orderData: [2, 2]
            }]
        });
    });
</script>