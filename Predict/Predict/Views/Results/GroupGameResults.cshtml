@model Predict.ViewModels.GroupGameResultsViewModel

@{
    ViewBag.Title = @ViewBag.EventName + " Fixtures";
}
@{
    var international = false;

    if (Model.EventFixtures.First().EventId == 219)
    {
        international = true;
    }
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Events/EventsIndex">Comps Home</a>
        </li>
        <li class="breadcrumb-item">
            <a href="/Events/EventsIndex">Comps List</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Comp Fixtures</li>
    </ol>
</nav>
<div>

    <table id="groupresults" name="groupresults" class="table table-bordered table-hover">
        <thead>
            <tr>

                <th class="hidden-xs hidden-sm" style="text-align: center; vertical-align: middle;"></th>
                <th style="text-align: center; vertical-align: middle;">Game</th>
                <th style="text-align: center; vertical-align: middle;">
                    Fixture Time
                </th>
            </tr>
        </thead>
        @for (var i = 0; i < Model.EventFixtures.Count(); i++)
        {
            <tr>

                <td class="hidden-xs hidden-sm" style="text-align: center; vertical-align: middle;" witdth="25%">
                    <b> @Model.EventFixtures[i].Fixture.League.ShortLeagueName </b>
                </td>

                <td style="text-align: center; vertical-align: middle;" witdth="50%">
                    <div class="container-fluid">
                        <div class="row vertical-middle text-center">
                            <div class="col-sm-6 text-center ; row no-gutters">
                                <table width="100%" cellpadding="2">
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(Model.EventFixtures[i].Fixture.HomeTeam.FlagFileLocation)" height="20" @(international ? "width=32" : "") />
                                        </td>
                                        <td style="text-align: left" width="60%">
                                            &nbsp
                                            @Html.DisplayFor(m => m.EventFixtures[i].Fixture.HomeTeam.TeamName)
                                        </td>
                                        <td style="text-align: left" width="20%">
                                            @Html.DisplayFor(m => m.EventFixtures[i].Fixture.HomeResult, new { @class = "control-label col-md-2" })
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-sm-6 text-center ; row no-gutters">
                                <table width="100%" cellpadding="2">
                                    <tr>
                                        <td width="20%">
                                            <img src="@Url.Content(Model.EventFixtures[i].Fixture.AwayTeam.FlagFileLocation)" height="20" @(international ? "width=32" : "") />
                                        </td>
                                        <td style="text-align: left" width="60%">
                                            &nbsp
                                            @Html.DisplayFor(m => m.EventFixtures[i].Fixture.AwayTeam.TeamName)
                                        </td>
                                        <td style="text-align: left" width="20%">
                                            @Html.DisplayFor(m => m.EventFixtures[i].Fixture.AwayResult, new { @class = "control-label col-md-2" })
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </td>

                <td style="text-align: center; vertical-align: middle;" witdth="25%" class="myDate">
                    @Html.Hidden("FixtureDateTime", Model.EventFixtures[i].Fixture.FixtureDateTime.ToLongDateString() + " " + Model.EventFixtures[i].Fixture.FixtureDateTime.ToShortTimeString())

                </td>

            </tr>
        }
    </table>

</div>
<script>

    $(function () {
        $("#fixtures").DataTable({
            "bLengthChange": false,
            "autoWidth": false
        });;
    });

</script>


<script>

    //get all td with actionclass in table
    $("tbody tr td.myDate").each(function () {

        $hiddenValue = $(this).find("input[type=hidden]").val();

        var d = new Date($hiddenValue);

        this.innerHTML = convertUTCDateToLocalDate(d);

    });

    function convertUTCDateToLocalDate(date) {
        var newDate = new Date(date.getTime() + date.getTimezoneOffset() * 60 * 1000);

        var offset = date.getTimezoneOffset() / 60;
        var hours = date.getHours();

        newDate.setHours(hours - offset);
        mo = new Intl.DateTimeFormat('en', { month: 'short' }).format(newDate);
        da = new Intl.DateTimeFormat('en', { day: '2-digit' }).format(newDate);

        return da + ' ' + mo + ' ' + pad(newDate.getHours(), 2) + ':' + pad(newDate.getMinutes(), 2);

    }

    function pad(n, width, z) {
        z = z || '0';
        n = n + '';
        return n.length >= width ? n : new Array(width - n.length + 1).join(z) + n;
    }

</script>