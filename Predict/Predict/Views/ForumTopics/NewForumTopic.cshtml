@model Predict.Models.ForumMessage

@{
    ViewBag.Title = "Add a new Topic";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/ForumTopics/ForumIndex">Message Board</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Add New Topic</li>
    </ol>
</nav>

@using (Html.BeginForm("SaveNewTopic", "ForumTopics"))

{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(a => a.PlayerId)
    @Html.HiddenFor(a => a.ForumTopic.PlayerId)

    <div class="form-group">
        @Html.LabelFor(model => model.ForumTopic.Topic, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.ForumTopic.Topic, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ForumTopic.Topic, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Message, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.Message, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-0 col-md-10">
            <input type="submit" value="Save" class="btn btn-success" />
        </div>
    </div>
}