@model Predict.ViewModels.PoolPlayerViewModel

@{
    ViewBag.Title = "Manage the players in your pool";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="~/PoolDashboard">Pool Admin</a>
        </li>
        <li class="breadcrumb-item">
            <a href="/Pools/">Manage Pools</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Manage Players</li>
    </ol>
</nav>

<table class="table table-bordered table-hover" id="poolPlayers">
    <thead>
    <tr>
        <th>
            Player Name
        </th>
        <th>
            Email 
        </th>
        <th>
            &nbsp
        </th>
    </tr>
    </thead>
    @for (var i = 0; i < Model.PoolPlayers.Count(); i++)
    {
        <tr>
            <td>
                <table>
                    <tr>
                        <td data-toggle="popover" title="Display Name: @Model.PoolPlayers[i].Player.DisplayName" data-content="Date Registered: @Model.PoolPlayers[i].Player.CreatedDateTime">
                            @Html.DisplayFor(m => m.PoolPlayers[i].Player.PlayerName)
                        </td>
                    </tr>
                </table>

            </td>
            <td>
                @Html.DisplayFor(m => m.PoolPlayers[i].Player.AspNetUser.Email)
            </td>
            <td>
                <button class="btn btn-danger js-delete btn-sm" value="Remove" dataPlayerId="@Model.PoolPlayers[i].PlayerId" dataPoolId="@Model.PoolPlayers[i].PoolId">Remove</button>

            </td>
        </tr>
    }
</table>
<script src="~/Scripts/bootbox.js"></script>
<script>

    $("#poolPlayers").on("click",
        ".js-delete",
        function() {
            var button = $(this);
            bootbox.confirm("Are you sure you want to remove this player from your pool?",
                function(result) {
                    if (result) {
                        $.ajax(
                            {
                                url: "../../api/poolPlayers/delete/" +
                                    button.attr("dataPoolId") +
                                    "/" +
                                    button.attr("dataPlayerId"),
                                method: "POST",
                                success: function() {
                                    $(button.closest("tr")).fadeOut(1000);
                                }
                            });
                    }
                });
        });

</script>

<script>
    $(function() {
        $("#poolPlayers").DataTable({
            'columnDefs': [
                {
                    'targets': [3, 4], /* column index */
                    'orderable': false /* true or false */

                }
            ]
        });
    });

</script>
<script>
    $(document).ready(function() {
        $('[data-toggle="popover"]').popover({
            placement: 'top',
            trigger: 'hover'
        });
    });
</script>
<style>
    .bs-example { margin: 150px 50px; }
</style>