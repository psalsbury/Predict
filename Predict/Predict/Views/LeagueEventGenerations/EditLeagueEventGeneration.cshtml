@model Predict.ViewModels.LeagueEventGenerationsEditViewModel

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Admin/AdminHome">Admin Home</a>
        </li>
        <li class="breadcrumb-item">
            <a href="/Leagues/LeaguesIndex">League List</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">League Generation</li>
    </ol>
</nav>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.LeagueEventGeneration.LeagueId)
    @Html.HiddenFor(model => model.LeagueEventGeneration.League.LeagueName)
    @Html.HiddenFor(model => model.LeagueEventGeneration.League.ShortLeagueName)

    <div class="form-horizontal">
        <h4>League Event Generation</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.LeagueEventGeneration.Id)

        <div class="form-group">
            @Html.LabelFor(model => model.LeagueEventGeneration.League.LeagueName, "LeagueName", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.LeagueEventGeneration.League.LeagueName, htmlAttributes: new { @readonly = "readonly" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.LeagueEventGeneration.GenerationFrequencyId, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.LeagueEventGeneration.GenerationFrequencyId, new SelectList(Model.GenerationTypes, "Id", "GenerationTypeName"), "Generation Type", new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.LeagueEventGeneration.TeamId, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.LeagueEventGeneration.TeamId, new SelectList(Model.Teams, "Id", "TeamName"), "Select Team", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.LeagueEventGeneration.TeamId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.LeagueEventGeneration.Enabled, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.LeagueEventGeneration.Enabled)
                    @Html.ValidationMessageFor(model => model.LeagueEventGeneration.Enabled, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "LeagueEventGenerationIndex")
</div>
