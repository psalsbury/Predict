
@model List<Predict.Models.RapidApiV3Country>

@using Predict.RapidApi
@{ 
    var nbrTimesApiCalled = ViewBag.nbrTimesApiCalled;
}

<p>Number of times Rapid Api Called Today = <b>@nbrTimesApiCalled</b></p>

@using (Html.BeginForm("SaveUpdateScoring", "Admin"))
{
    <div class="form-group">
        <div>
            @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
            <input type="submit" value="Update Scoring" class="btn btn-success" />
        </div>
    </div>
}

