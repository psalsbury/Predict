@model Predict.ViewModels.KoFixturePredictionViewModel

@{
    ViewBag.Title = Model.Predictions ? "Edit Knock Out Fixture Predictions" : "Edit Knock Out Fixture Results";
    var nbrKoPredictionsToEnter = (int)Session["nbrFixtures*" + Model.EventId];
    var nbrFixturePredictionsEntered = (int) Session["nbrFixturePredictions*" + Model.EventId];
    var disableAutoFill = nbrKoPredictionsToEnter - nbrFixturePredictionsEntered == 0 ? "" : "disabled";
    string autoFilButtonName="";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="~/">Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Knock Out Predictions</li>
    </ol>
</nav>

@using (Html.BeginForm(Model.Predictions ? (Model.ReadOnly ? "ReadOnly" : "Save") : "SaveKoResults", Model.Predictions ? "KoFixturePredictions" : "KoFixtures"))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.MaxRows)
    @Html.HiddenFor(model => model.MaxCols)
    @Html.HiddenFor(model => model.EventId)

    <div class="container-flex">
        <div class="row">
            <div class="col-md-3">
                <div class="panel panel-default flex-col">
                    <div class="panel-heading">Last 16 - <b>1 Point</b></div>
                    <div class="panel-body flex-grow">
                        @for (var a = 1; a <= 16; a++)
                        {
                            @Html.Raw(ReturnDropDown(16, a))
                        }
                    </div>
                    <div class="panel-footer">
                        @{ autoFilButtonName = "AutoFil_16"; }
                        <input class="btn btn-info" @disableAutoFill type="button" name="@autoFilButtonName" value="Auto Fill" id="@autoFilButtonName" onclick="AutoFill(this)">
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="panel panel-default flex-col">
                    <div class="panel-heading">Quarter Finalists - <b>2 Points</b></div>
                    <div class="panel-body flex-grow">
                        @for (var a = 1; a <= 8; a++)
                        {
                            @Html.Raw(ReturnDropDown(8, a))
                        }
                    </div>
                    <div class="panel-footer">
                        @{ autoFilButtonName = "AutoFil_8"; }
                        <input class="btn btn-info" @disableAutoFill type="button" name="@autoFilButtonName" value="Auto Fill" id="@autoFilButtonName" onclick="AutoFill(this)">
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="panel panel-default flex-col">
                    <div class="panel-heading">Semi Finalists - <b>4 Points</b></div>
                    <div class="panel-body flex-grow">
                        @for (var a = 1; a <= 4; a++)
                        {
                            @Html.Raw(ReturnDropDown(4, a))
                        }
                    </div>
                    <div class="panel-footer">
                        @{ autoFilButtonName = "AutoFil_4"; }
                        <input class="btn btn-info" @disableAutoFill type="button" name="@autoFilButtonName" value="Auto Fill" id="@autoFilButtonName" onclick="AutoFill(this)">
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="panel panel-default flex-col">
                    <div class="panel-heading">Finalists - <b>6 Points</b></div>
                    <div class="panel-body flex-grow">
                        @for (var a = 1; a <= 2; a++)
                        {
                            @Html.Raw(ReturnDropDown(2, a))
                        }
                    </div>
                    <div class="panel-footer">
                        @{ autoFilButtonName = "AutoFil_2"; }
                        <input class="btn btn-info" @disableAutoFill type="button" name="@autoFilButtonName" value="Auto Fill" id="@autoFilButtonName" onclick="AutoFill(this)">
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="panel panel-default flex-col">
                    <div class="panel-heading">Winner - <b>10 Points</b></div>
                    <div class="panel-body flex-grow">
                        @for (var a = 1; a <= 1; a++)
                        {
                            @Html.Raw(ReturnDropDown(1, a))
                        }
                    </div>
                    <div class="panel-footer">
                        @{ autoFilButtonName = "AutoFil_1"; }
                        <input class="btn btn-info" @disableAutoFill type="button" name="@autoFilButtonName" value="Auto Fill" id="@autoFilButtonName" onclick="AutoFill(this)">
                    </div>
                </div>
            </div>


        </div>
    </div>


    <div class="form-group">
        @Html.AntiForgeryToken() @* Its important to add this to all forms to stop hackers *@
        <input type="submit" value="Save" class="btn btn-success"/>
    </div>
}

@functions {

    public string ReturnDropDown(int roundOf, int position)
    {
        var listName = roundOf + "_" + position;
        var selectedTeam = "Not Selected";
        var defaultValue = "Select Team";
        var selectedValue = 0;

        if (roundOf == 1)
        {
            if (Model.KoWinningTeam != null)
            {
                selectedValue = Model.KoWinningTeam.TeamId ?? default(int);
                selectedTeam = Model.KoWinningTeam.Team.TeamName;
            }
        }
        else
        {
            var firstTeam = position % 2 != 0;

            var koFixturePosition = firstTeam ? (position + 1) / 2 : position / 2;
            var koFixturePredictions = Model.KoFixturePredictions.SingleOrDefault(k => k.KoFixture.RoundOf == roundOf && k.KoFixture.Position == koFixturePosition);
            if (koFixturePredictions != null)
            {
                selectedValue = firstTeam ? koFixturePredictions.Team1Id ?? default(int) : koFixturePredictions.Team2Id ?? default(int);
                if (firstTeam && koFixturePredictions.Team1 != null)
                {
                    selectedTeam = koFixturePredictions.Team1.TeamName;
                }

                if (!firstTeam && koFixturePredictions.Team2 != null)
                {
                    selectedTeam = koFixturePredictions.Team2.TeamName;
                }
            }
        }
        if (Model.ReadOnly)
        {
            return selectedTeam;
        }
        return Html.DropDownList(listName, new SelectList(Model.EventTeams, "TeamId", "TeamName", selectedValue), defaultValue, new {id = listName, @class = "myclass"}).ToString();
    }

}

<script>
    function AutoFill(obj) {
        var a;
        var objectName;
        var team1;
        var team2;
        var winningTeam;
        var teamsInOrder = [
            @{
                for (var a = 1; a <= Model.RankedTeamsForAutoFill.Count; a++)
                {
                    if (a != 1)
                    {
                        @:,
                    }
                    @:"@Model.RankedTeamsForAutoFill[a]"
                }
            }
        ];
        if (obj.id === "AutoFil_16") {
            @{
                if (Model.RankedTeamsForAutoFill.Count > 0)
                {
                    for (var a = 1; a <= 16; a++)
                    {
                        @:document.getElementById("16_@a").value = @Model.FirstStageAutoFill[a];
                    }
                }
            }
        } else {
            var thisRound = parseInt(obj.id.split('_')[1]);
            var previousRound = thisRound * 2;

            for (a = 1; a <= thisRound; a++) {
                objectName = previousRound.toString().concat("_").concat(((a * 2) - 1).toString());
                team1 = document.getElementById(objectName).value;
                objectName = previousRound.toString().concat("_").concat((a * 2).toString());
                team2 = document.getElementById(objectName).value;
                winningTeam = GetBestTeam(teamsInOrder, team1, team2);

                objectName = thisRound.toString().concat("_").concat(a.toString());
                document.getElementById(objectName).value = winningTeam;
            }
        }

    }

    function GetBestTeam(teamsInOrder, team1, team2) {
        var a;
        var nbrTeams = @Model.RankedTeamsForAutoFill.Count;
        for (a = 1; a <= nbrTeams; a++) {
            if (teamsInOrder[a - 1] === team1)
                return team1;
            if (teamsInOrder[a - 1] === team2)
                return team2;

        }
    }


</script>