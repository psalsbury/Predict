@using Predict.Models
@using WebHelpers.Mvc5
<aside class="main-sidebar">
    <section class="sidebar">

        @* BEGIN Menu *@
        <ul class="sidebar-menu" data-widget="tree">
            <li class="header">Prediction Menu</li>

            @if (Request.IsAuthenticated)
            {
                var eventPlayers = (List<EventPlayer>) Session["Events"];

                foreach (var eventPlayer in eventPlayers)
                {
                    <li class="treeview">
                        <a href="#">
                            <i class="fa fa-trophy"></i> <span>@eventPlayer.Event.EventName</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li>
                                <a href="@Url.Action("Index", "Home", new {eventId = eventPlayer.EventId})">
                                    <i class="fa fa-home"></i> <span>Home Page</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "Table", new {poolId = eventPlayer.Event.DefaultPoolId})">
                                    <i class="fa fa-table"></i> <span>Table</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "StatsGroup", new {eventId = eventPlayer.EventId})">
                                    <i class="fa fa-pie-chart"></i> <span>Game Stats</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("GroupGameResults", "Results", new {eventId = eventPlayer.EventId})">
                                    <i class="fa fa-soccer-ball-o"></i> <span>Results</span>
                                </a>
                            </li>


                        </ul>

                    </li>
                }

                if (User.IsInRole("Admin"))
                {
                    <li class="treeview">
                        <a href="#">
                            <i class="fa fa-gear"></i> <span>Admin</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">

                            @foreach (var eventPlayer in eventPlayers)
                            {
                                <li>
                                    <a href="@Url.Action("AdminHome", "Admin", new {eventId = eventPlayer.EventId})">
                                        <i class="fa fa-key"></i> <span>@eventPlayer.Event.EventName</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
            }
            else
            {
                <li class="@Url.IsLinkActive("Index", "Home")">
                    <a href="@Url.Action("Index", "Home")">
                        <i class="fa fa-home"></i> <span>Home</span>
                    </a>
                </li>
            }


            <li class="treeview">
                <a href="#">
                    <i class="fa fa-question-circle"></i> <span>Help</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                    
                <ul class="treeview-menu">
                    <li>
                        <a href="@Url.Action("Rules", "Home")">
                            <i class="fa fa-book"></i> <span>Rules</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("ContactUs", "Home")">
                            <i class="fa fa-envelope"></i> <span>Contact Us</span>
                        </a>
                    </li>
                </ul>
            </li>


        </ul>
        @* END Menu *@
    </section>
</aside>