@using Microsoft.AspNet.Identity
@model Predict.Models.Joke
@{ 

    var ownJoke = ViewBag.OwnJoke??false;
}


<style>

    #panel, #flip {
        padding: 5px;
        text-align: center;
        background-color: #f6f6f6;
        border: solid 1px #c3c3c3;
    }

    #panel {
        padding: 50px;
        display: none;
    }
</style>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Jokes/ShowJoke">Jokes</a>
        </li>
    </ol>
</nav>

<h1 style="text-align: center;">
    @Model.JokeText
</h1>

<div id="flip"><i class="fa fa-chevron-down"></i> &nbsp; Show Me The Punchline&nbsp;<i class="fa fa-chevron-down"></i></div>
<div id="panel">
    <h2>
        @Model.JokePunchline
    </h2>
</div>
<br />



<script>
    $(document).ready(function () {
        // Check Radio-box
        $(".rating input:radio").attr("checked", false);

        $('.rating input').click(function () {
            $(".rating span").removeClass('checked');
            $(this).parent().addClass('checked');
        });

        $('input:radio').change(
            function () {
                var userRating = this.value;
                $.ajax(
                    {
                        url: "../api/JokeRatings/PostJokeRating/@(User.Identity.GetUserId())" + "/" + @Model.Id + "/" + userRating,
                        method: "POST"
                    });
            });
    });
</script>

@if(!ownJoke)
{

    <style>
        * {
            margin: 0;
            padding: 0;
        }

        .rate {
            float: left;
            height: 46px;
            padding: 0 10px;
        }

            .rate:not(:checked) > input {
                position: absolute;
                top: -9999px;
            }

            .rate:not(:checked) > label {
                float: right;
                width: 1em;
                overflow: hidden;
                white-space: nowrap;
                cursor: pointer;
                font-size: 30px;
                color: #ccc;
            }

                .rate:not(:checked) > label:before {
                    content: '★ ';
                }

            .rate > input:checked ~ label {
                color: #ffc700;
            }

            .rate:not(:checked) > label:hover,
            .rate:not(:checked) > label:hover ~ label {
                color: #deb217;
            }

            .rate > input:checked + label:hover,
            .rate > input:checked + label:hover ~ label,
            .rate > input:checked ~ label:hover,
            .rate > input:checked ~ label:hover ~ label,
            .rate > label:hover ~ input:checked ~ label {
                color: #c59b08;
            }
    </style>

    <div id="rate" class="rate">
        <p>Please rate this joke:</p>
        <input type="radio" id="star5" name="rate" value="5" @(ViewBag.PlayerJokeRating == 5 ? "checked='checked'" : "") />
        <label for="star5" title="Very Funny">5 stars</label>
        <input type="radio" id="star4" name="rate" value="4" @(ViewBag.PlayerJokeRating == 4 ? "checked='checked'" : "") />
        <label for="star4" title="Made me chuckle">4 stars</label>
        <input type="radio" id="star3" name="rate" value="3" @(ViewBag.PlayerJokeRating == 3 ? "checked='checked'" : "") />
        <label for="star3" title="Not bad">3 stars</label>
        <input type="radio" id="star2" name="rate" value="2" @(ViewBag.PlayerJokeRating == 2 ? "checked='checked'" : "") />
        <label for="star2" title="Heard better">2 stars</label>
        <input type="radio" id="star1" name="rate" value="1" @(ViewBag.PlayerJokeRating == 1 ? "checked='checked'" : "") />
        <label for="star1" title="Rubbish">1 star</label>
    </div>

}

<script>
    @if(!ownJoke)
    {
           <text>$("#rate").hide();</text>
    }

    $(document).ready(function () {
        $("#flip").click(function () {
            $("#panel").slideToggle("slow");
            @if (!ownJoke)
            {
                <text> $("#rate").slideToggle("slow");  </text>

            }
                });

    });
</script>



<div style="float:right">
    <input type="button"
           value="Show Another Joke"
           class="btn btn-success"
           onclick="location.href = '@Url.Action("ShowJoke", "Jokes") '" />
</div>