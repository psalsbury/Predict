@model List<Predict.Models.League>

@{
    ViewBag.Title = "League List";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Admin/AdminHome">Admin Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">League List</li>
    </ol>
</nav>

<input class="form-control" id="myInput" type="text" placeholder="Search..">

<p>
    @Html.ActionLink("Create New League", "EditLeague", new { leagueId = 0 })
</p>

<table id="leagues" name="leagues" class="table table-bordered table-hover">
    <thead>
        <tr>

            <th style="text-align: left; vertical-align: middle;">League Name</th>
            <th style="text-align: left; vertical-align: middle;">RapidApiId</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td style="text-align: left; vertical-align: middle;">@item.LeagueName</td>
            <td style="text-align: left; vertical-align: middle;">@(item.RapidApiLeagueId==null?item.RapidApiV3LeagueSeasonId:item.RapidApiLeagueId)</td>
            <td style="text-align: left; vertical-align: middle;">@Html.ActionLink("Edit", "EditLeague", new { leagueId = item.Id })</td>
            <td style="text-align: left; vertical-align: middle;">
                @Html.ActionLink(
                    linkText: "Gens",
                    actionName: "LeagueEventGenerationsIndex",
                    controllerName: "LeagueEventGenerations",
                    routeValues: new
                    {
                        Id = item.Id
                    },
                    htmlAttributes: null
                )
            </td>
            <td style="text-align: left; vertical-align: middle;">
                @Html.ActionLink(
                    linkText: "Fxt",
                    actionName: "Index",
                    controllerName: "Fixtures",
                    routeValues: new
                    {
                        leagueId = item.Id
                    },
                    htmlAttributes: null
                )
            </td>


        </tr>
    }
</table>

<script>

        $(document).ready(function () {
            $("#myInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#leagues tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });

</script>