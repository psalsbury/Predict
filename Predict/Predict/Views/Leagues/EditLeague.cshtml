@model Predict.Models.League

@{ 
    var rapidApiV3LeagueSeasons = (SelectList)ViewBag.rapidApiV3LeagueSeasons;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Admin/AdminHome">Admin Home</a>
        </li>
        <li class="breadcrumb-item">
            <a href="/Leagues/LeaguesIndex">Leagues</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

@using (Html.BeginForm("Save", "Leagues"))
{
    @Html.AntiForgeryToken();

<div class="form-horizontal">
    <h4>League</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.CreatedDateTime)
    @Html.HiddenFor(model => model.RapidApiLeagueId)

    <div class="form-group">
        @Html.LabelFor(model => model.RapidApiV3LeagueSeasonId, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownList("RapidApiV3LeagueSeasonId", rapidApiV3LeagueSeasons, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.RapidApiV3LeagueSeasonId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.LeagueName, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.LeagueName, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.LeagueName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.ShortLeagueName, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.ShortLeagueName, new { htmlAttributes = new { @class = "form-control", @maxlength = "20" } })
            @Html.ValidationMessageFor(model => model.ShortLeagueName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.DailyRapidApiCheck, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.DailyRapidApiCheck)
            @Html.ValidationMessageFor(model => model.DailyRapidApiCheck, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Save" class="btn btn-success" />
        </div>
    </div>
</div>
}

<script>
    $("#RapidApiV3LeagueSeasonId").change(function () {
        HideShowTeamSelector(this);
    });

    function HideShowTeamSelector(object)
    {
        var selectedValue = $(object).children("option:selected").text();
        document.getElementById("LeagueName").value = selectedValue.slice(0, 25);
        document.getElementById("ShortLeagueName").value = selectedValue.slice(0, 15);
    }
</script>