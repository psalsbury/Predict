@using System.Configuration
@using PagedList.Mvc
@model PagedList.IPagedList<Predict.ViewModels.TableViewModel>


<style>
    table {
        border-collapse: collapse;
        width: 100%;
    }

    th, td {
        padding: 8px;
        text-align: left;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }
</style>

@{
    string supportFlagFileLocation = "";
    bool atLeastOnePlayerHasMissingPredictions = false;
    var flagFileLocation = ConfigurationManager.AppSettings["FlagFileLocation"];
    var fromBestPools = false;
    if (Request.UrlReferrer != null && Request.UrlReferrer.ToString().Contains("BestPools"))
    {
        fromBestPools = true;
    }

    var eventId = System.Convert.ToInt16(ViewBag.EventId.ToString());

    var nbrFixturePredictionsRequired = ViewBag.nbrFixturePredictionsRequired;
    var nbrKoPredictionsRequired = ViewBag.nbrKOPredictionsRequired;
    var nbrBonusPredictionsRequired = ViewBag.nbrBonusPredictionsRequired;

}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Home/Index?eventid=@ViewBag.EventId">Home</a>
        </li>
        @if (fromBestPools)
        {
            <li class="breadcrumb-item">
                <a href="/Table/BestPools?eventid=@ViewBag.EventId">Best Pools</a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">@ViewBag.PoolName table</li>
    </ol>
</nav>

<table class="table">
    <thead>
        <tr>
        <tr style="background-color: #428bca">
            <td style="background-color: #428bca; text-align: center">
                <b>
                    <font color="white">Pos</font>
                </b>
            </td>
            <td>
                <b>
                    <font color="white">Player Information</font>
                </b>
            </td>
            <td colspan="4" style="text-align: center">
                <b>
                    <font color="white">Points</font>
                </b>
            </td>
        </tr>
        <tr style="background-color: #428bca">
            <td>&nbsp</td>
            <td>&nbsp</td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>CS</b>
            </td>
            <td STYLE="color: WHITE; text-align: center;">
                <b>CR</b>
            </td>
            @if (ViewBag.nbrKoPredictionsRequired > 0)
            {
                <td STYLE="color: WHITE; text-align: center;">
                    <b>KO</b>
                </td>
            }
            <td STYLE="color: WHITE; text-align: center;">
                <b>Total</b>
            </td>
        </tr>
    </thead>

    @foreach (var tableViewModel in Model)
    {

        var nbrPredictionsEntered = (tableViewModel.FixturePredictionsEntered ?? 0) + (tableViewModel.KoPredictionsEntered ?? 0) + (tableViewModel.BonusPredictionsEntered ?? 0);
        var playerHasOutstandingPredictions = (nbrPredictionsEntered < (nbrFixturePredictionsRequired + nbrKoPredictionsRequired + nbrBonusPredictionsRequired));

        supportFlagFileLocation = "";
        if (tableViewModel.SupportTeamId != null && tableViewModel.SupportTeamId != 0)
        {
            supportFlagFileLocation = tableViewModel.SupportTeamFlag.Contains("http") ? tableViewModel.SupportTeamFlag : flagFileLocation + "/" + tableViewModel.SupportTeamFlag;
        }
        var popupBody = Html.ActionLink("View Predictions", "ViewPredictions", "PredictionsConsolidated", new { playerId = tableViewModel.PlayerId, poolId = tableViewModel.PoolId, eventId = tableViewModel.EventId }, null).ToHtmlString();

        <tr style="font-size: larger">
            <td style="text-align: center">
                @tableViewModel.PoolPosition.ToString()
            </td>

            <td>
                @Html.ActionLink(tableViewModel.DisplayName, "ViewPredictions", "PredictionsConsolidated", new { playerId = tableViewModel.PlayerId, poolId = tableViewModel.PoolId, eventId = tableViewModel.EventId }, null)
                @if (playerHasOutstandingPredictions)
                {
                    atLeastOnePlayerHasMissingPredictions = true;

                    <font color="red">*</font>
                }

                @if (supportFlagFileLocation != "")
                {
                    <text>&nbsp;</text>
                    <img src="@Url.Content(supportFlagFileLocation)" height="20" />
                }
            </td>

            <td STYLE="text-align: center">
                @tableViewModel.CorrectScore.ToString()
            </td>
            <td STYLE="text-align: center">
                @((tableViewModel.CorrectResult + @tableViewModel.WinMargin).ToString())
            </td>
            @if (ViewBag.nbrKoPredictionsRequired > 0)
            {
                <td STYLE="text-align: center">
                    @tableViewModel.KoScore.ToString()
                </td>
            }
            <td STYLE="text-align: center">
                @tableViewModel.TotalScore.ToString()
            </td>
        </tr>
    }

</table>
@if (atLeastOnePlayerHasMissingPredictions)
{
    <p style="color: red; font-style: italic; ">
        * = Predictions not complete
    </p>
}

<br />
<br />
Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("ShowTable",
    new { @ViewBag.EventId, ViewBag.PoolId, ViewBag.TableTypeId, page }))

<script>
    $(function () {
        $('[data-toggle="popover"]').popover({ html: true });
    });

    $('.popover-dismiss').popover({
        trigger: 'focus'
    });

</script>