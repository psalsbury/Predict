
@using Microsoft.AspNet.Identity
@using Predict.Models
@using System.Linq;
@model IEnumerable<Predict.Models.Event>

@{
    ViewBag.Title = "Competitions";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/Events/EventsIndex">Comps Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Comps List</li>
    </ol>
</nav>


@{
    var playerId = User.Identity.GetUserId();
}
@using (Html.BeginForm("SaveEvent", "Events"))

{
    @Html.AntiForgeryToken()

    <p>
        @Html.ActionLink("Create New Event", "AddEvent", new { eventId = ViewBag.EventId })
    </p>

    <table class="table" id="Events">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventName)
            </th>
            <th>Start Date</th>
            <th>End Date</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EventName)
                </td>
                <td>
                    @item.StartDateTime.ToString("dd MMM yy")
                </td>
                <td>
                    @item.EndDateTime.ToString("dd MMM yy")
                </td>
                <td>
                    <input type="button"
                           value="Add Fixtures"
                           class="btn btn-success"
                           onclick="location.href = '@Url.Action("Index", "EventFixtures", new {id = item.Id}) '" />
                    
                    <input type="button"
                           value="Show Fixtures"
                           class="btn btn-primary"
                           onclick="location.href = '@Url.Action("Index", "EventFixtures", new {id = item.Id}) '" />
                    
                    <input type="button"
                           value="Delete"
                           class="btn btn-danger"
                           onclick="location.href = '@Url.Action("Index", "EventFixtures", new {id = item.Id}) '" />

                    @if (@User.IsInRole("Admin"))
                    {
                        <input type="button"
                               value="KO Fixtures"
                               class="btn btn-success"
                               onclick="location.href = '@Url.Action("Index", "KoFixtures", new {id = item.Id}) '" />
                    }
                    <input type="button"
                           value="Edit"
                           class="btn btn-info"
                           onclick="location.href = '@Url.Action("EditEvent", "Events", new {id = item.Id}) '" />

                </td>
            </tr>
        }
    </table>
}


