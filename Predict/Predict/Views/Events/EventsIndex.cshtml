
@using Microsoft.AspNet.Identity
@model IEnumerable<Predict.Models.Event>

@{
    ViewBag.Title = "Manage Your Comps";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/CompsDashboard/CompsDashboardIndex">Comps Dashboard</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Manage Your Comps</li>
    </ol>
</nav>

<input class="form-control" id="myInput" type="text" placeholder="Search..">

@{
    var playerId = User.Identity.GetUserId();
}
@using (Html.BeginForm("SaveEvent", "Events"))

{
    @Html.AntiForgeryToken()

    <table class="table" id="Events">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.EventName)
                </th>
                <th class="hidden-xs">Start Date</th>
                <th class="hidden-xs">End Date</th>
                <th>&nbsp;</th>
            </tr>
        </thead>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <h4>@Html.DisplayFor(modelItem => item.EventName)</h4>
                </td>
                <td class="hidden-xs">

                    @(item.StartDateTime==DateTime.MinValue ? "N/A": item.StartDateTime.ToString("f"))
                </td>
                <td class="hidden-xs">
                    @(item.EndDateTime==DateTime.MinValue ? "N/A": item.EndDateTime.ToString("f"))
                </td>
                <td width="120">
                    @if (item.EventFinished && item.EndDateTime!=DateTime.MinValue)
                    {
                        @Html.ActionLink("Fixtures", "GroupGameResults", "Results", new { @id = item.Id }, new { @class = "btn btn-info" })
                    }
                    else
                    {

                        <div class="btn-group">
                            <button type="button" class="btn btn-success dropdown-toggle" data-toggle="dropdown">
                                Action
                                <span class="caret"></span>
                                <span class="sr-only">Toggle Dropdown</span>
                            </button>
                            <ul class="dropdown-menu" role="menu">
                                <li><a href="@Url.Action("Index", "EventFixtures", new {id = item.Id}) ">Add Fixtures</a></li>
                                <li><a href="@Url.Action("GroupGameResults", "Results", new {id = item.Id}) ">Show Fixtures</a></li>
                                @if (@User.IsInRole("Admin"))
                                {
                                    <li><a href="@Url.Action("Index", "KoFixtures", new {id = item.Id}) ">KO Fixtures</a></li>
                                }
                                <li><a href="@Url.Action("EditEvent", "Events", new {id = item.Id})">Edit Comp</a></li>
                                <li class="divider"></li>
                                <li class="js-delete" dataEventId="@item.Id" dataEventName="@item.EventName"><a href="#">Delete Comp</a></li>
                            </ul>
                        </div>
                    }
                </td>
            </tr>
        }
    </table>
}

<script src="~/Scripts/bootbox.js"></script>

<script>

    $(document).ready(function () {
        $("#myInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#Events tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });

</script>

<script>

    $("#Events").on("click", ".js-delete",
        function () {
            var button = $(this);
            bootbox.confirm("Are you sure you want to delete the " + button.attr("dataEventName") + " comp?",
                function (result) {
                    if (result) {
                        $.ajax(
                            {
                                url: "../api/events/delete/" + button.attr("dataEventId"),
                                method: "POST",
                                success: function () {

                                    $.ajax({
                                        type: "POST",
                                        url: "/webservices/wsEventPlayer.asmx/UpdateEventPlayerSession",
                                        data: "{}",
                                        contentType: "application/json",
                                        datatype: "json",
                                        success: function () {
                                            bootbox.alert("You have succesfully deleted the " + button.attr("dataEventName") + " comp");
                                            $(button.closest("tr")).fadeOut(1000);
                                            $('#sidebardiv').load('@Url.Action("_SideBar","Home")');
                                        },
                                        error: function (request, error) {
                                            alert('Please log out and back in to refresh');
                                        }
                                    });
                                },
                                error: function (request, error) {
                                    bootbox.alert(button.attr("dataEventName") + " comp could not be deleted");
                                }
                            });
                    }

                });
        });

</script>